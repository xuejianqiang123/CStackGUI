# C 侧构建产物（仅根目录 build\）
/build/
# 发布包（由 make-release.bat 生成）
release/
publish
# 每个工程里由编译脚本生成的东西（exe、运行时库副本）
# 注：这三行是注释不是规则 —— 仓库有意跟踪 examples 下的 exe 与 lib\（保持与源码同步）。
# 曾经还会在每个工程里生成一份 build-app.bat 薄壳，2026-10-07 已移除（编译入口只留项目根一个）
# examples/*/lib/
# examples/*/*.exe
# apps\ 是用户自己的工程目录，只保留说明文件
apps/*
!apps/README.md

# 画布（Node）
designer/node_modules/
designer/dist/
designer/release/

# 编辑器/系统（个人配置不入库）
.vscode/
.codebuddy/memory/
# 语言服务索引（tools\gen-cc.mjs 生成，相对路径、机器无关；
# 但 entry 清单随各机的 apps\ 工程而异，不入库）
compile_commands.json
*.o
*.a
Thumbs.db
desktop.ini

# WebView2 运行时创建的临时/用户数据目录（默认在 exe 旁）
*.exe.WebView2/
# WebView2 NuGet 包解包目录（nupkg 已入库，可重新解出）
webview2pkg/
# 随包附带的 Fixed Version Runtime（近 500MB，重新下载即可，见 webview2.nupkg）
runtime/res/WebView2Runtime/
examples/*/WebView2Runtime/
# 临时下载/解包产物
build/_wv2fv*
# 团队协作的运行态（不是工程内容）
.codebuddy/teams/

# 测试套件在仓库根目录留下的产物（kit/term 那几个测试把输出写到了当前目录）
cg_doc_dump.txt
kit_bom.txt
kit_dir/
kit_test.ini
kit_test.txt
term_test.txt
