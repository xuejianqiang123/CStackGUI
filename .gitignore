# C 侧构建产物（仅根目录 build\）
/build/
# 发布包（由 make-release.bat 生成）
release/
publish
# 每个工程里由编译脚本生成的东西（exe、运行时库副本）
# 2026-10-08 起不再跟踪 examples 下的 exe：编译产物本地生成即可，避免每次构建都改动入库（曾有意跟踪以保持同步，现已改为忽略）。
examples/*/*.exe
examples/*/*/*.exe
# examples/*/lib/ 仍按原意跟踪（与源码同步）
# apps\ 是用户自己的工程目录，只保留说明文件
apps/*
!apps/README.md

# 画布（Node）
designer/node_modules/
designer/dist/
designer/release/

# 编辑器/系统（个人配置不入库）
.vscode/
.codebuddy/memory/
# 语言服务索引（tools\gen-cc.mjs 生成，相对路径、机器无关；
# 但 entry 清单随各机的 apps\ 工程而异，不入库）
compile_commands.json
*.o
*.a
# gcc -MMD 生成的依赖清单（cgbuild 精确增量用；与 .o 同目录同性质，2026-10-17 起）
*.d
Thumbs.db
desktop.ini

# WebView2 运行时创建的临时/用户数据目录（默认在 exe 旁）
*.exe.WebView2/
# WebView2 NuGet 包解包目录（nupkg 已入库，可重新解出）
webview2pkg/
# 随包附带的 Fixed Version Runtime（近 500MB，重新下载即可，见 webview2.nupkg）
runtime/res/WebView2Runtime/
examples/*/WebView2Runtime/
# 临时下载/解包产物
build/_wv2fv*
# 团队协作的运行态（不是工程内容）
.codebuddy/teams/

# 测试套件在仓库根目录留下的产物（kit/term/gif 那几个测试把输出写到了当前目录）
cg_doc_dump.txt
_gif_*.gif
kit_bom.txt
kit_dir/
kit_test.ini
kit_test.txt
term_test.txt

# envsnap 运行时在 exe 旁生成的清单（用户数据，机器本地，首次运行自动重建）
examples/envsnap/envsnap.ini
