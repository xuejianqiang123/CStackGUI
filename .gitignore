# C 侧构建产物（仅根目录 build\）
/build/
# 发布包（由 make-release.bat 生成）
release/
publish
# 每个工程里由编译脚本生成的东西（exe、运行时库副本、编译入口）
# examples/*/lib/
# examples/*/*.exe
# examples/*/build-app.bat
# apps\ 是用户自己的工程目录，只保留说明文件
apps/*
!apps/README.md

# 画布（Node）
designer/node_modules/
designer/dist/
designer/release/

# 编辑器/系统（个人配置不入库）
.vscode/
.codebuddy/memory/
# 语言服务索引（tools\gen-cc.mjs 生成，相对路径、机器无关；
# 但 entry 清单随各机的 apps\ 工程而异，不入库）
compile_commands.json
*.o
*.a
Thumbs.db
desktop.ini

# WebView2 运行时创建的临时/用户数据目录（默认在 exe 旁）
*.exe.WebView2/
# WebView2 NuGet 包解包目录（nupkg 已入库，可重新解出）
webview2pkg/
