/* cstackgui.rc -- 把图标、清单与版本信息打进业务 exe */
#include <windows.h>

/* 图标单一来源：想换图标直接替换 cstackgui.ico（需含 256x256 尺寸），
 * 画布打包（designer/package.json win.icon）也指向这个文件。 */
1 ICON "cstackgui.ico"

1 RT_MANIFEST "cstackgui.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,1,0,0
  PRODUCTVERSION 0,1,0,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName",      "CStackGUI"
      VALUE "FileDescription",  "CStackGUI Application"
      VALUE "FileVersion",      "0.1.0.0"
      VALUE "InternalName",     "cstackgui"
      VALUE "OriginalFilename", "CStackGUI.exe"
      VALUE "ProductName",      "CStackGUI"
      VALUE "ProductVersion",   "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
