  "actions": {
    "np_new": {
      "text": "新建",
      "accel": "Ctrl+N",
      "handler": "np_on_file_new"
    },
    "np_open": {
      "text": "打开...",
      "accel": "Ctrl+O",
      "handler": "np_on_file_open"
    },
    "np_save": {
      "text": "保存",
      "accel": "Ctrl+S",
      "handler": "np_on_file_save"
    },
    "np_save_as": {
      "text": "另存为...",
      "accel": "Ctrl+Shift+S",
      "handler": "np_on_file_save"
    }
  }
}
