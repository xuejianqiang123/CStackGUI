{
  "cgui": 1,
  "app": {
    "title": "text 套件",
    "width": 1080,
    "height": 740,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI text 套件",
      "desc": "原 notepad / logfilter / filecheck / dataview / htmlreport / datarec 合并（每工具一页签）",
      "comments": "由 tools\\suite-merge.mjs 合并生成",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": {
      "close": "suite_close",
      "size": "suite_size",
      "drop": "suite_drop"
    }
  },
  "widgets": [
    {
      "id": "sv_pages",
      "type": "tabs",
      "rect": {
        "x": 6,
        "y": 6,
        "w": 1068,
        "h": 728
      },
      "items": [
        "notepad",
        "logfilter",
        "filecheck",
        "dataview",
        "htmlreport",
        "datarec"
      ],
      "children": [
        {
          "id": "np_menu_main",
          "type": "menu",
          "events": {
            "click": "np_on_menu_click"
          },
          "nodes": [
            {
              "text": "文件",
              "children": [
                {
                  "action": "np_new"
                },
                {
                  "action": "np_open"
                },
                {
                  "action": "np_save"
                },
                {
                  "action": "np_save_as"
                },
                {
                  "text": "-"
                },
                {
                  "text": "退出",
                  "id": "np_m_quit"
                }
              ]
            },
            {
              "text": "编辑",
              "children": [
                {
                  "text": "复制全部",
                  "id": "np_m_copy"
                },
                {
                  "text": "粘贴",
                  "id": "np_m_paste"
                },
                {
                  "text": "清空",
                  "id": "np_m_clear"
                }
              ]
            },
            {
              "text": "帮助",
              "children": [
                {
                  "text": "关于",
                  "id": "np_m_about"
                }
              ]
            }
          ],
          "page": 0
        },
        {
          "id": "np_edt_body",
          "type": "edit",
          "rect": {
            "x": 12,
            "y": 12,
            "w": 736,
            "h": 500
          },
          "style": {
            "font": "Microsoft YaHei UI",
            "size": 10
          },
          "multiline": true,
          "scroll": 2,
          "events": {
            "change": "np_on_body_change"
          },
          "page": 0
        },
        {
          "id": "np_sb_main",
          "type": "statusbar",
          "rect": {
            "x": 0,
            "y": 536,
            "w": 760,
            "h": 24
          },
          "items": [
            "未命名",
            "0 字",
            "行 1"
          ],
          "page": 0
        },
        {
          "id": "lf_sb_main",
          "type": "statusbar",
          "rect": {
            "x": 0,
            "y": 616,
            "w": 1020,
            "h": 24
          },
          "items": [
            "还没打开文件",
            "条件：无关键字（全部行）",
            "命中 0 行 / 共 0 行 / 0 ms"
          ],
          "page": 1
        },
        {
          "id": "lf_grp_open",
          "type": "group",
          "rect": {
            "x": 12,
            "y": 8,
            "w": 996,
            "h": 96
          },
          "text": "① 打开日志文件（文本；上限 32 MB）",
          "children": [
            {
              "id": "lf_btn_open",
              "type": "button",
              "rect": {
                "x": 16,
                "y": 32,
                "w": 180,
                "h": 32
              },
              "text": "打开日志文件...",
              "hint": "选一个文本日志。超过 32 MB 只取前 32 MB 并提示切分（运行时的文件接口没有分块 / 流式读）",
              "events": {
                "click": "lf_on_btn_open_click"
              }
            },
            {
              "id": "lf_lab_size",
              "type": "label",
              "rect": {
                "x": 208,
                "y": 38,
                "w": 420,
                "h": 22
              },
              "text": "还没打开文件"
            },
            {
              "id": "lf_btn_clear",
              "type": "button",
              "rect": {
                "x": 640,
                "y": 32,
                "w": 150,
                "h": 32
              },
              "text": "清空视图",
              "hint": "清掉终端与行号表；文件内容还留着，改条件可以直接重滤",
              "events": {
                "click": "lf_on_btn_clear_click"
              }
            },
            {
              "id": "lf_prg_work",
              "type": "progress",
              "rect": {
                "x": 802,
                "y": 38,
                "w": 178,
                "h": 20
              },
              "value": 0,
              "vmax": 3,
              "hint": "0 未开始 / 1 已读取 / 2 过滤中 / 3 完成（整读模式拿不到按字节的进度）"
            },
            {
              "id": "lf_lab_stage",
              "type": "label",
              "rect": {
                "x": 208,
                "y": 64,
                "w": 772,
                "h": 22
              },
              "text": "进度条只表示「读取 / 过滤 / 完成」三步：没有分块读接口，做不出按百分比的解析进度。"
            }
          ],
          "page": 1
        },
        {
          "id": "lf_grp_filter",
          "type": "group",
          "rect": {
            "x": 12,
            "y": 112,
            "w": 996,
            "h": 116
          },
          "text": "② 过滤条件",
          "children": [
            {
              "id": "lf_lab_a",
              "type": "label",
              "rect": {
                "x": 16,
                "y": 32,
                "w": 56,
                "h": 22
              },
              "text": "关键字 A"
            },
            {
              "id": "lf_edt_kw_a",
              "type": "edit",
              "rect": {
                "x": 76,
                "y": 28,
                "w": 300,
                "h": 26
              },
              "hint": "子串匹配（不是正则）；留空表示这一条不参与",
              "events": {
                "change": "lf_on_cond_change"
              }
            },
            {
              "id": "lf_lab_b",
              "type": "label",
              "rect": {
                "x": 392,
                "y": 32,
                "w": 56,
                "h": 22
              },
              "text": "关键字 B"
            },
            {
              "id": "lf_edt_kw_b",
              "type": "edit",
              "rect": {
                "x": 452,
                "y": 28,
                "w": 300,
                "h": 26
              },
              "hint": "与 A 之间按下面的「与 / 或」组合",
              "events": {
                "change": "lf_on_cond_change"
              }
            },
            {
              "id": "lf_btn_filter",
              "type": "button",
              "rect": {
                "x": 770,
                "y": 26,
                "w": 210,
                "h": 32
              },
              "text": "开始过滤",
              "hint": "按当前条件重扫一遍工作窗口，结果进终端与行号表",
              "events": {
                "click": "lf_on_btn_filter_click"
              }
            },
            {
              "id": "lf_chk_case",
              "type": "checkbox",
              "rect": {
                "x": 16,
                "y": 66,
                "w": 130,
                "h": 26
              },
              "text": "区分大小写",
              "checked": false,
              "hint": "不勾 = 忽略大小写（只折叠 ASCII 字母，中文不受影响）",
              "events": {
                "change": "lf_on_cond_change"
              }
            },
            {
              "id": "lf_chk_or",
              "type": "checkbox",
              "rect": {
                "x": 156,
                "y": 66,
                "w": 200,
                "h": 26
              },
              "text": "A 或 B（不勾 = 与）",
              "checked": false,
              "hint": "运行时没有正则接口，两个关键字只有「与 / 或」两种组合方式",
              "events": {
                "change": "lf_on_cond_change"
              }
            },
            {
              "id": "lf_chk_invert",
              "type": "checkbox",
              "rect": {
                "x": 366,
                "y": 66,
                "w": 250,
                "h": 26
              },
              "text": "反向：只显示不含关键字的行",
              "checked": false,
              "hint": "两个关键字都空时勾它 = 0 行命中（有意如此）",
              "events": {
                "change": "lf_on_cond_change"
              }
            },
            {
              "id": "lf_btn_copy",
              "type": "button",
              "rect": {
                "x": 640,
                "y": 64,
                "w": 190,
                "h": 30
              },
              "text": "命中内容复制到剪贴板",
              "hint": "把命中行（带行号）攒成一段文本放进剪贴板，上限 256 KB",
              "events": {
                "click": "lf_on_btn_copy_click"
              }
            },
            {
              "id": "lf_btn_export",
              "type": "button",
              "rect": {
                "x": 838,
                "y": 64,
                "w": 142,
                "h": 30
              },
              "text": "导出结果...",
              "hint": "弹「保存文件」对话框，把命中行写成 UTF-8 文本（攒块 + 追加，不整份驻留内存）",
              "events": {
                "click": "lf_on_btn_export_click"
              }
            }
          ],
          "page": 1
        },
        {
          "id": "lf_grp_view",
          "type": "group",
          "rect": {
            "x": 12,
            "y": 236,
            "w": 996,
            "h": 372
          },
