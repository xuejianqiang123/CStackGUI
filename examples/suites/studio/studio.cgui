    "info": {
      "product": "CStackGUI studio 工作台",
      "desc": "comm / dev / text 三套件合并（16 工具一页签一个）",
      "comments": "由 tmp/studio_merge.mjs 合并生成；sys 托盘工具未并入（关窗语义冲突）",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": {
      "close": "suite_close",
      "destroy": "suite_destroy",
      "size": "suite_size",
      "drop": "suite_drop"
    }
  },
