          "type": "chart",
          "rect": {
            "x": 12,
            "y": 12,
            "w": 560,
            "h": 420
          },
          "items": [
            "设备A",
            "设备B"
          ],
          "value": 200,
          "vmin": 0,
          "vmax": 100,
          "hint": "两条曲线：一次推一个点的接口，value = 窗口保留的点数（不是当前值）",
          "page": 15
        },
        {
          "id": "dr_edt_path",
          "type": "edit",
          "rect": {
            "x": 12,
            "y": 440,
            "w": 560,
            "h": 30
          },
          "text": "（尚未保存）",
          "input": 1,
          "hint": "最近一次保存 / 回放的 CSV 路径（只读）",
          "page": 15
        },
        {
          "id": "dr_btn_start",
          "type": "button",
          "rect": {
            "x": 12,
            "y": 482,
            "w": 134,
            "h": 36
          },
          "text": "开始采集",
          "hint": "挂一颗 200ms 的一次性定时器；回调里自己重挂，形成周期",
          "events": {
            "click": "dr_on_btn_start_click"
          },
          "page": 15
        },
        {
          "id": "dr_btn_stop",
          "type": "button",
          "rect": {
            "x": 154,
            "y": 482,
            "w": 134,
            "h": 36
          },
          "text": "停止",
          "hint": "杀掉在跳的定时器；内存缓冲留着，保存 CSV 要用",
          "events": {
            "click": "dr_on_btn_stop_click"
          },
          "page": 15
        },
        {
          "id": "dr_btn_save",
          "type": "button",
          "rect": {
            "x": 296,
            "y": 482,
            "w": 134,
            "h": 36
          },
          "text": "保存 CSV",
          "hint": "先覆盖写表头，再按 4KB 分块追加，不在内存里拼整份 CSV",
          "events": {
            "click": "dr_on_btn_save_click"
          },
          "page": 15
        },
        {
          "id": "dr_btn_replay",
          "type": "button",
          "rect": {
            "x": 438,
            "y": 482,
            "w": 134,
            "h": 36
          },
          "text": "回放",
          "hint": "读回 CSV → 逐行解析 → 清空图表后重放",
          "events": {
            "click": "dr_on_btn_replay_click"
          },
          "page": 15
        },
        {
          "id": "dr_lst_log",
          "type": "listbox",
          "rect": {
            "x": 584,
            "y": 12,
            "w": 304,
            "h": 568
          },
          "hint": "采集与落盘日志：追加一条 + 滚到底",
          "page": 15
        }
      ]
    }
