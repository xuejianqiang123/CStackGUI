  "actions": {
    "sh_shot": {
      "text": "开始截图(&S)",
      "accel": "Ctrl+Alt+A",
      "handler": "sh_on_action"
    },
    "sh_rec": {
      "text": "录屏 GIF(&R)",
      "accel": "Ctrl+Alt+G",
      "handler": "sh_on_action"
    },
    "sh_quit": {
      "text": "退出(&Q)",
      "accel": "Ctrl+Shift+Q",
      "handler": "sh_on_action"
    },
    "tr_toggle_win": {
      "text": "显示 / 隐藏窗口(&H)",
      "accel": "Ctrl+Shift+H",
      "handler": "tr_on_action"
    },
    "tr_toggle_dark": {
      "text": "切换深色 / 浅色(&D)",
      "accel": "Ctrl+Shift+D",
      "handler": "tr_on_action"
    },
    "tr_copy_time": {
      "text": "时间戳写进剪贴板(&C)",
      "accel": "Ctrl+Shift+C",
      "handler": "tr_on_action"
    },
    "tr_shot": {
      "text": "窗口截图存 PNG(&S)",
      "accel": "Ctrl+Shift+S",
      "handler": "tr_on_action"
    },
    "tr_quit": {
      "text": "退出(&Q)",
      "handler": "tr_on_action"
    }
  }
}
