{
  "cgui": 1,
  "app": {
    "title": "sys 套件",
    "width": 1000,
    "height": 640,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI sys 套件",
      "desc": "原 shottool / traytool / syspanel / envsnap / settings 合并（每工具一页签）",
      "comments": "由 tools\\suite-merge.mjs 合并生成",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": {
      "close": "suite_close",
      "tray": "suite_tray",
      "keydown": "suite_keydown",
      "size": "suite_size",
      "move": "suite_move",
      "show": "suite_show",
      "hide": "suite_hide"
    }
  },
  "widgets": [
    {
      "id": "sv_pages",
      "type": "tabs",
      "rect": {
        "x": 6,
        "y": 6,
        "w": 988,
        "h": 628
      },
      "items": [
        "shottool",
        "traytool",
        "syspanel",
        "envsnap",
        "settings"
      ],
      "children": [
        {
          "id": "sh_sb_main",
          "type": "statusbar",
          "rect": {
            "x": 0,
            "y": 416,
            "w": 600,
            "h": 24
          },
          "items": [
            "就绪",
            "热键 Ctrl+Alt+A",
            "截图 0 张"
          ],
          "page": 0
        },
        {
          "id": "sh_lab_title",
          "type": "label",
          "rect": {
            "x": 12,
            "y": 10,
            "w": 576,
            "h": 22
          },
          "text": "QQ 风格截图工具：托盘常驻 · 全局热键 · 框选 · 标注 · 一键复制",
          "style": {
            "font": "Microsoft YaHei UI",
            "size": 10,
            "bold": true
          },
          "page": 0
        },
        {
          "id": "sh_lab_tip1",
          "type": "label",
          "rect": {
            "x": 12,
            "y": 38,
            "w": 576,
            "h": 20
          },
          "text": "按 Ctrl+Alt+A（或「开始截图」/ 左键点托盘图标）→ 屏幕上按住拖动框选 → 松手进标注",
          "page": 0
        },
        {
          "id": "sh_lab_tip2",
          "type": "label",
          "rect": {
            "x": 12,
            "y": 60,
            "w": 576,
            "h": 20
          },
          "text": "标注条在选区下方：「完成」= 存 PNG + 复制到剪贴板；Esc = 取消；「贴图」把结果钉在屏幕上",
          "page": 0
        },
        {
          "id": "sh_btn_shot",
          "type": "button",
          "rect": {
            "x": 12,
            "y": 88,
            "w": 160,
            "h": 32
          },
          "text": "开始截图(&S)",
          "action": "sh_shot",
          "hint": "等价于全局热键 Ctrl+Alt+A（热键被占用时的兜底入口）",
          "page": 0
        },
        {
          "id": "sh_btn_quit",
          "type": "button",
          "rect": {
            "x": 180,
            "y": 88,
            "w": 96,
            "h": 32
          },
          "text": "退出(&Q)",
