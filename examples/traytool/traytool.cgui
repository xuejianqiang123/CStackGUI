{
  "cgui": 1,
  "app": {
    "title": "托盘小工具",
    "width": 560,
    "height": 420,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 托盘小工具",
      "desc": "托盘常驻小工具：托盘图标 / 关窗即最小化 / 全局快捷键 / 剪贴板 / 截图 / 深浅主题",
      "comments": "示例 traytool：五条命令写成 actions（各带 accel），C 侧一个回调全部服务",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": {
      "close": "on_close",
      "tray": "on_tray",
      "show": "on_show",
      "hide": "on_hide"
    }
  },
  "actions": {
    "toggle_win":  { "text": "显示 / 隐藏窗口(&H)", "accel": "Ctrl+Shift+H", "handler": "on_action" },
    "toggle_dark": { "text": "切换深色 / 浅色(&D)", "accel": "Ctrl+Shift+D", "handler": "on_action" },
    "copy_time":   { "text": "时间戳写进剪贴板(&C)", "accel": "Ctrl+Shift+C", "handler": "on_action" },
    "shot":        { "text": "窗口截图存 PNG(&S)",  "accel": "Ctrl+Shift+S", "handler": "on_action" },
    "quit":        { "text": "退出(&Q)",            "accel": "Ctrl+Shift+Q", "handler": "on_action" }
  },
  "widgets": [
    {
      "id": "menu_main",
      "type": "menu",
      "events": { "click": "on_menu_click" },
      "nodes": [
        {
          "text": "程序",
          "children": [
            { "action": "toggle_win" },
            { "action": "toggle_dark" },
            { "text": "-" },
            { "action": "quit" }
          ]
        },
        {
          "text": "操作",
          "children": [
            { "action": "copy_time" },
            { "action": "shot" },
            { "text": "-" },
            { "text": "清空日志", "id": "m_clear" },
            { "text": "弹个托盘气泡", "id": "m_balloon" }
          ]
        },
        {
          "text": "帮助",
          "children": [{ "text": "关于", "id": "m_about" }]
        }
      ]
    },
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 396, "w": 560, "h": 24 },
      "items": ["就绪", "主题：浅色", "截图 0 张"]
    },
    {
      "id": "lab_state",
      "type": "label",
      "rect": { "x": 12, "y": 12, "w": 536, "h": 22 },
      "text": "窗口：显示中　主题：浅色　截图：0 张",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "bold": true }
    },
    {
      "id": "lab_tip",
      "type": "label",
      "rect": { "x": 12, "y": 38, "w": 536, "h": 20 },
      "text": "点右上角关闭 = 最小化到托盘（进程继续跑）；真正退出用「程序 → 退出」或 Ctrl+Shift+Q"
    },
    {
      "id": "lab_tip2",
      "type": "label",
      "rect": { "x": 12, "y": 60, "w": 536, "h": 20 },
      "text": "托盘图标：左键单击 = 显示 / 隐藏，左键双击 = 叫回窗口，右键 = 拉出窗口走菜单"
    },
    {
      "id": "lst_log",
      "type": "listbox",
      "rect": { "x": 12, "y": 88, "w": 536, "h": 302 },
      "hint": "操作日志：追加一条 + 滚到底（日志类控件的标准写法）"
    }
  ]
}
