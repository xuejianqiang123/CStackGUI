{
  "cgui": 1,
  "app": {
    "title": "编码与换行转换器",
    "width": 1020,
    "height": 672,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 编码转换器",
      "desc": "GBK/UTF-8 互转 + 换行统一：整读 + 8 MB 上限，判定按 UTF-8 校验，可能误判",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": { "close": "on_close" }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 648, "w": 1020, "h": 24 },
      "items": ["还没枚举目录", "方向：GBK → UTF-8 · 换行：保持原样 · BOM：不写", "共 0 个 / 待转 0 / 已转 0 / 跳过 0 / 失败 0"]
    },
    {
      "id": "grp_top",
      "type": "group",
      "rect": { "x": 12, "y": 8, "w": 996, "h": 112 },
      "text": "① 目录与选项（单文件上限 8 MB / 一次最多 200 个）",
      "children": [
        {
          "id": "lab_dir",
          "type": "label",
          "rect": { "x": 16, "y": 34, "w": 44, "h": 22 },
          "text": "目录"
        },
        {
          "id": "edt_dir",
          "type": "edit",
          "rect": { "x": 64, "y": 28, "w": 430, "h": 26 },
          "hint": "填要扫描的目录。没有「选目录」对话框，所以手填路径；或点右边的便捷按钮"
        },
        {
          "id": "btn_datadir",
          "type": "button",
          "rect": { "x": 502, "y": 28, "w": 150, "h": 28 },
          "text": "用用户数据目录",
          "hint": "把用户数据目录填进目录框（该目录会自动创建）",
          "events": { "click": "on_btn_click" }
        },
        {
          "id": "btn_scan",
          "type": "button",
          "rect": { "x": 660, "y": 28, "w": 150, "h": 28 },
          "text": "枚举文件",
          "hint": "按文本类扩展名枚举目录；每个文件整读一遍做判定（可能较慢）",
          "events": { "click": "on_btn_click" }
        },
        {
          "id": "btn_preview",
          "type": "button",
          "rect": { "x": 816, "y": 28, "w": 176, "h": 28 },
          "text": "预览选中",
          "hint": "把选中文件前 20 行按当前判定试解后显示（双击表格也行）",
          "events": { "click": "on_btn_click" }
        },
        {
          "id": "lab_dir2",
          "type": "label",
          "rect": { "x": 16, "y": 70, "w": 44, "h": 22 },
          "text": "方向"
        },
        {
          "id": "cbo_dir",
          "type": "combo",
          "rect": { "x": 64, "y": 64, "w": 180, "h": 26 },
          "items": ["GBK → UTF-8", "UTF-8 → GBK"],
          "value": 0,
          "hint": "目标方向。候选由「判定」列决定：GBK→UTF-8 只转疑似 GBK 的文件"
        },
        {
          "id": "lab_nl",
          "type": "label",
          "rect": { "x": 260, "y": 70, "w": 44, "h": 22 },
          "text": "换行"
        },
        {
          "id": "cbo_nl",
          "type": "combo",
          "rect": { "x": 308, "y": 64, "w": 160, "h": 26 },
          "items": ["保持原样", "统一 CRLF", "统一 LF"],
          "value": 0,
          "hint": "换行统一在转换之后做：CRLF 与孤立的 CR 都归成所选风格"
        },
        {
          "id": "chk_bom",
          "type": "checkbox",
          "rect": { "x": 488, "y": 64, "w": 170, "h": 26 },
          "text": "写 UTF-8 BOM",
          "checked": false,
          "hint": "只在 GBK → UTF-8 时有效；UTF-8 → GBK 会被忽略（GBK 无 BOM）"
        },
        {
          "id": "chk_overwrite",
          "type": "checkbox",
          "rect": { "x": 664, "y": 64, "w": 210, "h": 26 },
          "text": "覆盖原文件（危险）",
          "checked": false,
          "hint": "默认不覆盖：输出到同目录新文件。勾上后需再点一次「开始转换」才真覆盖"
        },
        {
          "id": "btn_convert",
          "type": "button",
          "rect": { "x": 880, "y": 62, "w": 112, "h": 30 },
          "text": "开始转换",
          "hint": "逐个候选转换并落盘；每个文件报「原名 → 新名 / 字节变化 / 结论」",
          "events": { "click": "on_btn_click" }
        }
      ]
    },
    {
      "id": "grp_main",
      "type": "group",
      "rect": { "x": 12, "y": 128, "w": 996, "h": 488 },
      "grow": 1,
      "text": "② 文件列表（左） / 日志与预览（右）",
      "children": [
        {
          "id": "tbl_files",
          "type": "table",
          "rect": { "x": 16, "y": 26, "w": 560, "h": 440 },
          "columns": [
            { "title": "文件名", "w": 250 },
            { "title": "大小", "w": 84 },
            { "title": "判定", "w": 96 },
            { "title": "结论" }
          ],
          "events": { "dblclick": "on_preview" }
        },
        {
          "id": "term_out",
          "type": "terminal",
          "rect": { "x": 584, "y": 26, "w": 396, "h": 440 },
          "grow": 1,
          "checked": false,
          "value": 5000,
          "hint": "上：程序说明 / 操作结果；下：预览内容（按某编码试解，乱码即乱码）"
        }
      ]
    },
    {
      "id": "prg_main",
      "type": "progress",
      "rect": { "x": 12, "y": 624, "w": 996, "h": 18 },
      "value": 0,
      "min": 0,
      "max": 100,
      "hint": "整读模式拿不到按字节的进度，只表示「处理到第几个文件」"
    }
  ]
}
