{
  "cgui": 1,
  "app": {
    "title": "进制与校验工具箱",
    "width": 980,
    "height": 560,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 进制与校验工具箱",
      "desc": "面向工控与嵌入式调试的纯计算工具：字节视图 / 校验 / 编码 / 报文组装",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 536, "w": 980, "h": 24 },
      "items": ["就绪", "字节 0 · 按 HEX 解析"]
    },
    {
      "id": "grp_ctrl",
      "type": "group",
      "rect": { "x": 12, "y": 8, "w": 470, "h": 516 },
      "text": "输入与操作",
      "children": [
        {
          "id": "lab_input",
          "type": "label",
          "rect": { "x": 14, "y": 30, "w": 440, "h": 20 },
          "text": "输入（十六进制或文本，勾选框决定按哪种解析）",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        },
        {
          "id": "edt_input",
          "type": "edit",
          "rect": { "x": 14, "y": 54, "w": 442, "h": 196 },
          "multiline": true,
          "scroll": 2,
          "style": { "font": "Consolas", "size": 10 },
          "hint": "十六进制支持空格 / 逗号 / 连字符分隔，如 48 65 6C 6C 6F",
          "events": { "change": "on_input_change" }
        },
        {
          "id": "chk_hex",
          "type": "checkbox",
          "rect": { "x": 14, "y": 258, "w": 240, "h": 28 },
          "text": "按 HEX 解析（不勾选按文本）",
          "checked": true,
          "hint": "勾选走十六进制解码，不勾选按文本原样取字节",
          "events": { "change": "on_mode_change" }
        },
        {
          "id": "btn_parse",
          "type": "button",
          "rect": { "x": 266, "y": 256, "w": 190, "h": 32 },
          "text": "解析字节",
          "hint": "字节视图 + 全部校验（CRC16 / CRC32 / MD5 / SHA1 / SHA256）",
          "events": { "click": "on_parse_click" }
        },
        {
          "id": "sep_1",
          "type": "separator",
          "rect": { "x": 14, "y": 296, "w": 442, "h": 2 }
        },
        {
          "id": "btn_b64_enc",
          "type": "button",
          "rect": { "x": 14, "y": 306, "w": 140, "h": 30 },
          "text": "Base64 编码",
          "hint": "把解析出的字节编成 Base64",
          "events": { "click": "on_b64_enc_click" }
        },
        {
          "id": "btn_b64_dec",
          "type": "button",
          "rect": { "x": 162, "y": 306, "w": 140, "h": 30 },
          "text": "Base64 解码",
          "hint": "把输入框内容当 Base64 解开",
          "events": { "click": "on_b64_dec_click" }
        },
        {
          "id": "btn_hex2txt",
          "type": "button",
          "rect": { "x": 310, "y": 306, "w": 146, "h": 30 },
          "text": "HEX → 文本",
          "hint": "十六进制解成文本，非可打印字节按点显示",
          "events": { "click": "on_hex2txt_click" }
        },
        {
          "id": "btn_url_enc",
          "type": "button",
          "rect": { "x": 14, "y": 344, "w": 140, "h": 30 },
          "text": "URL 编码",
          "hint": "百分号编码",
          "events": { "click": "on_url_enc_click" }
        },
        {
          "id": "btn_url_dec",
          "type": "button",
          "rect": { "x": 162, "y": 344, "w": 140, "h": 30 },
          "text": "URL 解码",
          "hint": "百分号转义还原",
          "events": { "click": "on_url_dec_click" }
        },
        {
          "id": "btn_txt2hex",
          "type": "button",
          "rect": { "x": 310, "y": 344, "w": 146, "h": 30 },
          "text": "文本 → HEX",
          "hint": "文本编成十六进制串",
          "events": { "click": "on_txt2hex_click" }
        },
        {
          "id": "sep_2",
          "type": "separator",
          "rect": { "x": 14, "y": 384, "w": 442, "h": 2 }
        },
        {
          "id": "btn_frame",
          "type": "button",
          "rect": { "x": 14, "y": 394, "w": 442, "h": 34 },
          "text": "组装协议帧并预览（HEX）",
          "hint": "帧头 + 地址 + 功能码 + 长度 + 载荷 + 校验 + 帧尾，走 cg_proto_build",
          "events": { "click": "on_frame_click" }
        },
        {
          "id": "lab_ops",
          "type": "label",
          "rect": { "x": 14, "y": 440, "w": 442, "h": 24 },
          "text": "结果逐行输出到右侧终端；状态栏显示最近一次操作。",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        }
      ]
    },
    {
      "id": "sp_main",
      "type": "splitter",
      "rect": { "x": 486, "y": 8, "w": 6, "h": 516 },
      "hint": "左右拖动：撑开左栏，终端整体让位并吃掉余量",
      "events": { "release": "on_split_release" }
    },
    {
      "id": "term_out",
      "type": "terminal",
      "rect": { "x": 496, "y": 8, "w": 472, "h": 516 },
      "grow": 1,
      "checked": true,
      "value": 2000
    }
  ]
}
