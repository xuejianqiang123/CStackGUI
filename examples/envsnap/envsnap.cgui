{
  "cgui": 1,
  "app": {
    "title": "环境与配置快照",
    "width": 1000,
    "height": 640,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 环境快照",
      "desc": "环境与配置快照示例：INI 清单驱动的懒加载树 + 目录快照，清单可导入与增删改查",
      "version": "1.1.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 616, "w": 1000, "h": 24 },
      "items": ["就绪", "条目 0 · 目录 0", "—"]
    },
    {
      "id": "btn_refresh",
      "type": "button",
      "rect": { "x": 12, "y": 12, "w": 120, "h": 32 },
      "text": "重新采集",
      "hint": "清空树与节点表，重扫用户数据目录并重建两个根节点（清单不动）",
      "events": { "click": "on_btn_refresh_click" }
    },
    {
      "id": "btn_export",
      "type": "button",
      "rect": { "x": 140, "y": 12, "w": 120, "h": 32 },
      "text": "导出快照",
      "hint": "弹保存对话框，把当前已采集的内容写成 UTF-8 文本",
      "events": { "click": "on_btn_export_click" }
    },
    {
      "id": "btn_copy",
      "type": "button",
      "rect": { "x": 268, "y": 12, "w": 120, "h": 32 },
      "text": "复制快照",
      "hint": "把同一份快照文本送进剪贴板",
      "events": { "click": "on_btn_copy_click" }
    },
    {
      "id": "lab_hint",
      "type": "label",
      "rect": { "x": 404, "y": 16, "w": 584, "h": 24 },
      "text": "展开节点才采集；导出 / 复制对当前已采集的内容做一次快照"
    },
    {
      "id": "btn_import",
      "type": "button",
      "rect": { "x": 12, "y": 48, "w": 112, "h": 32 },
      "text": "导入INI",
      "hint": "选一份 INI 重新载入清单；此后的增删改都存回它",
      "events": { "click": "on_btn_import_click" }
    },
    {
      "id": "btn_add",
      "type": "button",
      "rect": { "x": 132, "y": 48, "w": 112, "h": 32 },
      "text": "添加",
      "hint": "分组 / 变量名 / 备注 三步输入；同组同名重复会被拒",
      "events": { "click": "on_btn_add_click" }
    },
    {
      "id": "btn_del",
      "type": "button",
      "rect": { "x": 252, "y": 48, "w": 112, "h": 32 },
      "text": "删除",
      "hint": "删选中的变量；选中分组则整组连带删除（无二次确认）",
      "events": { "click": "on_btn_del_click" }
    },
    {
      "id": "btn_edit",
      "type": "button",
      "rect": { "x": 372, "y": 48, "w": 112, "h": 32 },
      "text": "修改",
      "hint": "预填三步输入：改名 / 挪分组 / 改备注",
      "events": { "click": "on_btn_edit_click" }
    },
    {
      "id": "btn_find",
      "type": "button",
      "rect": { "x": 492, "y": 48, "w": 112, "h": 32 },
      "text": "查询",
      "hint": "按关键字过滤清单（分组 / 变量名 / 备注），结果摆进右侧表格",
      "events": { "click": "on_btn_find_click" }
    },
    {
      "id": "lab_ops",
      "type": "label",
      "rect": { "x": 612, "y": 52, "w": 364, "h": 24 },
      "text": "清单在 envsnap.ini：改动自动存回，记事本改完点「导入INI」"
    },
    {
      "id": "grp_mid",
      "type": "group",
      "rect": { "x": 12, "y": 88, "w": 976, "h": 364 },
      "text": "采集内容（左：树 · 右：条目）",
      "children": [
        {
          "id": "tree_main",
          "type": "tree",
          "rect": { "x": 12, "y": 24, "w": 360, "h": 304 },
          "hint": "展开才采集；变量 / 分组 / 目录 / 扩展名各有不同的条目表",
          "events": { "select": "on_tree_sel", "expand": "on_tree_expand" }
        },
        {
          "id": "sp_main",
          "type": "splitter",
          "format": "col",
          "rect": { "x": 376, "y": 24, "w": 6, "h": 304 },
          "hint": "左右拖动：树变宽 / 变窄，右边的表格跟着让位"
        },
        {
          "id": "tbl_items",
          "type": "table",
          "rect": { "x": 386, "y": 24, "w": 578, "h": 304 },
          "columns": [
            { "title": "名称", "w": 240 },
            { "title": "值或大小", "w": 180 },
            { "title": "备注" }
          ],
          "hint": "变量 / 扩展名 / 目录 / 根与分组节点各有不同的列内容"
        }
      ]
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 12, "y": 460, "w": 976, "h": 148 },
      "checked": true,
      "value": 800,
      "hint": "每行一条采集与导出记录"
    },
    {
      "id": "dlg_edit",
      "type": "dialog",
      "rect": { "x": 0, "y": 0, "w": 400, "h": 210 },
      "text": "添加变量",
      "events": { "show": "on_dlg_show" },
      "children": [
        {
          "id": "lab_dlg_group",
          "type": "label",
          "rect": { "x": 20, "y": 22, "w": 84, "h": 24 },
          "text": "分组："
        },
        {
          "id": "edt_dlg_group",
          "type": "edit",
          "rect": { "x": 108, "y": 20, "w": 272, "h": 26 },
          "hint": "写 [方括号] 里的那个名字；改成别的就是换分组"
        },
        {
          "id": "lab_dlg_name",
          "type": "label",
          "rect": { "x": 20, "y": 62, "w": 84, "h": 24 },
          "text": "变量名："
        },
        {
          "id": "edt_dlg_name",
          "type": "edit",
          "rect": { "x": 108, "y": 60, "w": 272, "h": 26 },
          "hint": "比如 PATH、TEMP；同一分组里不能重名"
        },
        {
          "id": "lab_dlg_note",
          "type": "label",
          "rect": { "x": 20, "y": 102, "w": 84, "h": 24 },
          "text": "备注（可空）："
        },
        {
          "id": "edt_dlg_note",
          "type": "edit",
          "rect": { "x": 108, "y": 100, "w": 272, "h": 26 },
          "hint": "会写进 ini 的 = 号后面，表格与快照里都显示"
        },
        {
          "id": "lab_dlg_hint",
          "type": "label",
          "rect": { "x": 20, "y": 138, "w": 360, "h": 24 },
          "text": "",
          "style": { "fg": "#B3261E" }
        },
        {
          "id": "btn_dlg_ok",
          "type": "button",
          "rect": { "x": 200, "y": 168, "w": 88, "h": 30 },
          "text": "确定",
          "hint": "一次提交三个字段；不合法就留在框里改，不关框",
          "events": { "click": "on_dlg_ok" }
        },
        {
          "id": "btn_dlg_cancel",
          "type": "button",
          "rect": { "x": 296, "y": 168, "w": 88, "h": 30 },
          "text": "取消",
          "hint": "不写清单，直接关框（Esc 同效）",
          "events": { "click": "on_dlg_cancel" }
        }
      ]
    }
  ]
}
