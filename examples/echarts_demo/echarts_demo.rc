/* echarts_demo.rc -- 程序图标 + v6 控件清单 + 版本信息
 * 由 CStackGUI 画布生成（工具栏「程序配置」对话框），改内容请回画布改后重新导出。
 * build-app.bat 用 windres 编译它：文件是 UTF-8，所以带 --codepage=65001。
 */
#pragma code_page(65001)

#include <windows.h>

1 ICON "cstackgui.ico"

/* v6 通用控件清单：少了它标签页/进度条是老式外观 */
1 RT_MANIFEST "cstackgui.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,0,0,0
  PRODUCTVERSION 0,0,0,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "FileVersion", "0.0.0.0"
      VALUE "InternalName", "echarts_demo"
      VALUE "OriginalFilename", "echarts_demo.exe"
      VALUE "ProductName", "echarts_demo"
      VALUE "ProductVersion", "0.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
