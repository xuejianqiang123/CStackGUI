{
  "cgui": 1,
  "app": {
    "title": "工具箱启动器 1.1.0",
    "width": 860,
    "height": 668,
    "bg": "@surface",
    "info": {
      "product": "CStackGUI 工具箱启动器",
      "desc": "8 页签按钮墙 + 分组条 + 成对装/撤开关 + 搜索 + 最近使用 + 我的工具（INI 槽位）+ 深浅主题；功能面对标 mxx1-toolbox",
      "version": "1.1.0.0",
      "author": "CStackGUI"
    }
  },
  "styles": {
    "sect": {
      "font": "Microsoft YaHei UI",
      "size": 9.5,
      "bold": true,
      "fg": "@inkSub"
    },
    "btn": {
      "font": "Microsoft YaHei UI",
      "size": 9.5,
      "fg": "@ink",
      "bg": "@card",
      "radius": 8
    },
    "primary": {
      "font": "Microsoft YaHei UI",
      "size": 9.5,
      "fg": "@accentInk",
      "bg": "@accent",
      "radius": 8
    },
    "install": {
      "font": "Microsoft YaHei UI",
      "size": 9.5,
      "fg": "@ok",
      "bg": "@okSoft",
      "radius": 8
    },
    "remove": {
      "font": "Microsoft YaHei UI",
      "size": 9.5,
      "fg": "@danger",
      "bg": "@dangerSoft",
      "radius": 8
    },
    "note": {
      "font": "Microsoft YaHei UI",
      "size": 9,
      "fg": "@inkSub"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": {
        "x": 0,
        "y": 640,
        "w": 860,
        "h": 24
      },
      "items": [
        "就绪",
        "点按钮或回车搜索；开关在「常用设置」页"
      ]
    },
    {
      "id": "lab_find",
      "type": "label",
      "rect": {
        "x": 12,
        "y": 16,
        "w": 44,
        "h": 24
      },
      "text": "搜索",
      "style": {
        "bold": true
      }
    },
    {
      "id": "edt_search",
      "type": "edit",
      "rect": {
        "x": 64,
        "y": 12,
        "w": 320,
        "h": 28
      },
      "text": "",
      "hint": "按名称或命令过滤；回车启动第一个匹配",
      "events": {
        "change": "on_edt_search_change",
        "submit": "on_edt_search_submit"
      }
    },
    {
      "id": "tab_main",
      "type": "tabs",
      "rect": {
        "x": 12,
        "y": 50,
        "w": 836,
        "h": 546
      },
      "items": [
        "常用",
        "常用设置",
        "我的工具",
        "系统工具",
        "清理优化",
        "隐私设置",
        "应用管理",
        "右键增强"
      ],
      "events": {
        "select": "on_tab_main_select"
      },
      "children": [
        {
          "id": "lab_recent_t",
