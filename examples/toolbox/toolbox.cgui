        { "id": "tool_acthist",  "type": "button", "page": 5, "rect": { "x": 8,   "y": 106, "w": 192, "h": 34 }, "text": "活动历史记录", "events": { "click": "on_tool_click" } },
        { "id": "tool_diag",     "type": "button", "page": 5, "rect": { "x": 206, "y": 106, "w": 192, "h": 34 }, "text": "诊断和反馈",   "events": { "click": "on_tool_click" } },
        { "id": "tool_adid",     "type": "button", "page": 5, "rect": { "x": 404, "y": 106, "w": 192, "h": 34 }, "text": "广告 ID",       "events": { "click": "on_tool_click" } },
        { "id": "tool_speech",   "type": "button", "page": 5, "rect": { "x": 602, "y": 106, "w": 192, "h": 34 }, "text": "语音",           "events": { "click": "on_tool_click" } },
        { "id": "lab_priv_note", "type": "label", "page": 5, "rect": { "x": 8, "y": 150, "w": 804, "h": 34 },
          "text": "原版在这一页放的是真开关（改系统注册表 + 备份还原）。本工程注册表接口只能读写字符串值、没有删值与枚举，示例不碰系统键 —— 所以入口直达对应设置页，改不改由你在系统设置里决定；「装上/撤掉」模式在常用设置页用沙箱键完整演示。", "style": "note" },

        { "id": "lab_sect_apps", "type": "label", "page": 6, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
