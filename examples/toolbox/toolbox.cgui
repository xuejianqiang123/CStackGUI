        { "id": "tool_recycle",  "type": "button", "page": 4, "rect": { "x": 602, "y": 64, "w": 192, "h": 34 }, "text": "回收站",     "events": { "click": "on_tool_click" } },
        { "id": "lab_sect_tmp", "type": "label", "page": 4, "rect": { "x": 8, "y": 108, "w": 804, "h": 22 },
          "text": "  临时与缓存（只打开 / 只查看，不自动删）", "style": "sect" },
        { "id": "tool_temp",     "type": "button", "page": 4, "rect": { "x": 8,   "y": 136, "w": 192, "h": 34 }, "text": "用户临时目录",   "events": { "click": "on_tool_click" } },
        { "id": "tool_wintemp",  "type": "button", "page": 4, "rect": { "x": 206, "y": 136, "w": 192, "h": 34 }, "text": "系统临时目录",   "events": { "click": "on_tool_click" } },
        { "id": "tool_wucache",  "type": "button", "page": 4, "rect": { "x": 404, "y": 136, "w": 192, "h": 34 }, "text": "更新缓存目录",   "events": { "click": "on_tool_click" } },
        { "id": "tool_flushdns", "type": "button", "page": 4, "rect": { "x": 602, "y": 136, "w": 192, "h": 34 }, "text": "刷新 DNS 缓存", "events": { "click": "on_tool_click" } },
        { "id": "lab_sect_maint", "type": "label", "page": 4, "rect": { "x": 8, "y": 180, "w": 804, "h": 22 },
          "text": "  系统维护（校验类，不改动）", "style": "sect" },
        { "id": "tool_sfc",      "type": "button", "page": 4, "rect": { "x": 8,   "y": 208, "w": 192, "h": 34 }, "text": "系统文件校验",     "events": { "click": "on_tool_click" } },
        { "id": "tool_dism",     "type": "button", "page": 4, "rect": { "x": 206, "y": 208, "w": 192, "h": 34 }, "text": "映像完整性检查", "events": { "click": "on_tool_click" } },
        { "id": "tool_rstrui",   "type": "button", "page": 4, "rect": { "x": 404, "y": 208, "w": 192, "h": 34 }, "text": "系统还原",         "events": { "click": "on_tool_click" } },
        { "id": "tool_trouble",  "type": "button", "page": 4, "rect": { "x": 602, "y": 208, "w": 192, "h": 34 }, "text": "疑难解答",         "events": { "click": "on_tool_click" } },
        { "id": "lab_clean_hint", "type": "label", "page": 4, "rect": { "x": 8, "y": 252, "w": 804, "h": 34 },
          "text": "本页全部「只打开 / 只查看」：真清理请在磁盘清理界面里自己勾选，示例不自动删任何文件。sfc 用 /verifyonly 只校验不修复。", "style": "note" },

        { "id": "lab_sect_priv", "type": "label", "page": 5, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
