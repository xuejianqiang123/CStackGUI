          "text": "扫描右键菜单", "hint": "枚举 HKCU 用户区五个区域，逐项读 MUIVerb / command / LegacyDisable",
          "events": { "click": "on_btn_regmenu_scan_click" } },
        { "id": "lab_regmenu_note", "type": "label", "page": 7, "rect": { "x": 206, "y": 142, "w": 606, "h": 20 },
          "text": "扫描是只读的；选中一行后用按钮禁用 / 恢复 / 备份并删除（每次操作后自动重扫）", "style": "note" },
        { "id": "lab_sect_rmenu2", "type": "label", "page": 7, "rect": { "x": 8, "y": 172, "w": 804, "h": 20 },
          "text": "  扫描结果（HKCU 用户区；点一行选中，再用下面的按钮操作）", "style": "sect" },
        { "id": "tbl_regmenu", "type": "table", "page": 7, "rect": { "x": 8, "y": 196, "w": 804, "h": 196 },
          "columns": [
            { "title": "区域", "w": 110 },
            { "title": "标题", "w": 170 },
            { "title": "命令" },
            { "title": "状态", "w": 76 }
          ],
          "hint": "区域 / 标题 / 命令 / 状态（在用 · 已隐藏 · 无命令）；点一行选中后即可操作" },
        { "id": "btn_rm_disable", "type": "button", "page": 7, "rect": { "x": 8, "y": 398, "w": 180, "h": 30 },
          "text": "禁用选中（隐藏）", "style": "remove", "hint": "给选中项写 LegacyDisable：右键菜单里不再出现，键仍在，可原样恢复",
          "events": { "click": "on_rm_disable_click" } },
        { "id": "btn_rm_enable", "type": "button", "page": 7, "rect": { "x": 194, "y": 398, "w": 180, "h": 30 },
          "text": "恢复选中（取消隐藏）", "style": "install", "hint": "删掉选中项的 LegacyDisable 值，菜单项重新出现",
          "events": { "click": "on_rm_enable_click" } },
        { "id": "btn_rm_backup_del", "type": "button", "page": 7, "rect": { "x": 380, "y": 398, "w": 200, "h": 30 },
          "text": "备份并删除选中…", "style": "remove", "hint": "先把整个键导出成 .reg 存数据目录，再整键删除；破坏性，会先弹确认框",
          "events": { "click": "on_rm_backup_del_click" } },
        { "id": "btn_rm_restore", "type": "button", "page": 7, "rect": { "x": 586, "y": 398, "w": 200, "h": 30 },
          "text": "还原本次改动", "hint": "本次会话禁用过的全部取消隐藏、删过的从备份 .reg 导回",
          "events": { "click": "on_rm_restore_click" } },
        { "id": "lab_rm_stat", "type": "label", "page": 7, "rect": { "x": 8, "y": 432, "w": 804, "h": 18 },
          "text": "（还没有扫描）" },
        { "id": "lab_rm_changed", "type": "label", "page": 7, "rect": { "x": 8, "y": 452, "w": 804, "h": 18 },
          "text": "曾改动：无", "style": "note" },
        { "id": "lab_rm_lim", "type": "label", "page": 7, "rect": { "x": 8, "y": 474, "w": 804, "h": 20 },
          "text": "边界照实说：只动 HKCU；系统区（HKLM）与 shellex 扩展项扫不到。「备份并删除」删前自动导出 .reg 存数据目录，可导回。", "style": "note" }
      ]
    },

