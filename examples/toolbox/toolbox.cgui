{
  "cgui": 1,
  "app": {
    "title": "工具箱启动器 1.1.0",
    "width": 860,
    "height": 668,
    "bg": "#EEF1F4",
    "info": {
      "product": "CStackGUI 工具箱启动器",
      "desc": "8 页签按钮墙 + 分组条 + 成对装/撤开关 + 搜索 + 最近使用 + 我的工具（INI 槽位）+ 深浅主题；功能面对标 mxx1-toolbox",
      "version": "1.1.0.0",
      "author": "CStackGUI"
    }
  },
  "styles": {
    "sect":    { "font": "Microsoft YaHei UI", "size": 10, "bold": true, "fg": "#33383D", "bg": "#D9DEE3" },
    "install": { "font": "Microsoft YaHei UI", "size": 10, "bold": true, "fg": "#1B6E33", "bg": "#E7F5EC" },
    "remove":  { "font": "Microsoft YaHei UI", "size": 10, "bold": true, "fg": "#C03030", "bg": "#FBEAEA" },
    "note":    { "font": "Microsoft YaHei UI", "size": 9 }
  },
  "widgets": [
    { "id": "sb_main", "type": "statusbar", "rect": { "x": 0, "y": 640, "w": 860, "h": 24 },
      "items": ["就绪", "工具箱", "v1.1.0.0"] },

    { "id": "lab_find", "type": "label", "rect": { "x": 12, "y": 16, "w": 48, "h": 24 },
      "text": "搜索", "style": { "bold": true } },
    { "id": "edt_search", "type": "edit", "rect": { "x": 64, "y": 12, "w": 320, "h": 28 },
      "text": "", "hint": "按名称或命令过滤；回车启动第一个匹配",
      "events": { "change": "on_edt_search_change", "submit": "on_edt_search_submit" } },
    { "id": "lab_find_hint", "type": "label", "rect": { "x": 396, "y": 16, "w": 452, "h": 24 },
      "text": "加工具：本文件加按钮 + main.c 的 k_tools 加一行；我的工具改 mytools.ini 即可", "style": "note" },

    {
      "id": "tab_main", "type": "tabs", "rect": { "x": 12, "y": 50, "w": 836, "h": 546 },
      "items": ["常用", "常用设置", "我的工具", "系统工具", "清理优化", "隐私设置", "应用管理", "右键增强"],
      "events": { "select": "on_tab_main_select" },
      "children": [
        { "id": "lab_recent_t", "type": "label", "page": 0, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
          "text": "  最近使用（最新在前）", "style": "sect" },
        { "id": "lst_recent", "type": "listbox", "page": 0, "rect": { "x": 8, "y": 64, "w": 600, "h": 400 },
          "hint": "最近启动过的工具；双击行再次启动" },
        { "id": "btn_recent_clear", "type": "button", "page": 0, "rect": { "x": 616, "y": 64, "w": 196, "h": 30 },
          "text": "清空记录", "hint": "清空最近使用（内存记录）",
          "events": { "click": "on_btn_recent_clear_click" } },
        { "id": "btn_open_data", "type": "button", "page": 0, "rect": { "x": 616, "y": 100, "w": 196, "h": 30 },
          "text": "打开数据目录", "hint": "mytools.ini 所在目录",
          "events": { "click": "on_btn_open_data_click" } },
        { "id": "lab_recent_hint", "type": "label", "page": 0, "rect": { "x": 8, "y": 470, "w": 804, "h": 22 },
          "text": "记录只存内存、最多 8 条；记不记可在「常用设置」里开关。", "style": "note" },

        { "id": "lab_sect_opt", "type": "label", "page": 1, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
          "text": "  行为开关（装上 / 撤掉，落点：本工具箱沙箱键，真实可逆）", "style": "sect" },
        { "id": "opt0_on",  "type": "button", "page": 1, "rect": { "x": 8,   "y": 64, "w": 192, "h": 34 }, "text": "装上：日志镜像到控制台", "style": "install", "events": { "click": "on_opt_click" } },
        { "id": "opt0_off", "type": "button", "page": 1, "rect": { "x": 206, "y": 64, "w": 192, "h": 34 }, "text": "撤掉", "style": "remove", "events": { "click": "on_opt_click" } },
        { "id": "lab_opt0", "type": "label", "page": 1, "rect": { "x": 404, "y": 72, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "opt1_on",  "type": "button", "page": 1, "rect": { "x": 8,   "y": 106, "w": 192, "h": 34 }, "text": "装上：日志行首加时间戳", "style": "install", "events": { "click": "on_opt_click" } },
        { "id": "opt1_off", "type": "button", "page": 1, "rect": { "x": 206, "y": 106, "w": 192, "h": 34 }, "text": "撤掉", "style": "remove", "events": { "click": "on_opt_click" } },
        { "id": "lab_opt1", "type": "label", "page": 1, "rect": { "x": 404, "y": 114, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "opt2_on",  "type": "button", "page": 1, "rect": { "x": 8,   "y": 148, "w": 192, "h": 34 }, "text": "装上：敲字自动切搜索页", "style": "install", "events": { "click": "on_opt_click" } },
        { "id": "opt2_off", "type": "button", "page": 1, "rect": { "x": 206, "y": 148, "w": 192, "h": 34 }, "text": "撤掉", "style": "remove", "events": { "click": "on_opt_click" } },
        { "id": "lab_opt2", "type": "label", "page": 1, "rect": { "x": 404, "y": 156, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "opt3_on",  "type": "button", "page": 1, "rect": { "x": 8,   "y": 190, "w": 192, "h": 34 }, "text": "装上：记录最近使用", "style": "install", "events": { "click": "on_opt_click" } },
        { "id": "opt3_off", "type": "button", "page": 1, "rect": { "x": 206, "y": 190, "w": 192, "h": 34 }, "text": "撤掉", "style": "remove", "events": { "click": "on_opt_click" } },
        { "id": "lab_opt3", "type": "label", "page": 1, "rect": { "x": 404, "y": 198, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "opt4_on",  "type": "button", "page": 1, "rect": { "x": 8,   "y": 232, "w": 192, "h": 34 }, "text": "装上：右键沙箱标记", "style": "install", "events": { "click": "on_opt_click" } },
        { "id": "opt4_off", "type": "button", "page": 1, "rect": { "x": 206, "y": 232, "w": 192, "h": 34 }, "text": "撤掉", "style": "remove", "events": { "click": "on_opt_click" } },
        { "id": "lab_opt4", "type": "label", "page": 1, "rect": { "x": 404, "y": 240, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "btn_reg_view", "type": "button", "page": 1, "rect": { "x": 8,   "y": 274, "w": 192, "h": 34 },
          "text": "查看曾改动", "hint": "把沙箱键里 5 个开关的当前值弹出来看",
          "events": { "click": "on_btn_reg_view_click" } },
        { "id": "btn_reg_reset", "type": "button", "page": 1, "rect": { "x": 206, "y": 274, "w": 192, "h": 34 },
          "text": "还原全部开关", "hint": "5 个值全写空串（本工程没有删值接口，值空 = 未设）",
          "events": { "click": "on_btn_reg_reset_click" } },
        { "id": "lab_reg_note", "type": "label", "page": 1, "rect": { "x": 404, "y": 282, "w": 408, "h": 20 },
          "text": "沙箱键：HKCU\\Software\\CStackGUI\\examples\\toolbox", "style": "note" },

        { "id": "lab_sect_entry", "type": "label", "page": 1, "rect": { "x": 8, "y": 320, "w": 804, "h": 22 },
          "text": "  常用入口", "style": "sect" },
        { "id": "tool_taskmgr", "type": "button", "page": 1, "rect": { "x": 8,   "y": 348, "w": 192, "h": 34 }, "text": "任务管理器",   "events": { "click": "on_tool_click" } },
        { "id": "tool_control", "type": "button", "page": 1, "rect": { "x": 206, "y": 348, "w": 192, "h": 34 }, "text": "控制面板",     "events": { "click": "on_tool_click" } },
        { "id": "tool_env",     "type": "button", "page": 1, "rect": { "x": 404, "y": 348, "w": 192, "h": 34 }, "text": "环境变量",     "events": { "click": "on_tool_click" } },
        { "id": "tool_userpwd", "type": "button", "page": 1, "rect": { "x": 602, "y": 348, "w": 192, "h": 34 }, "text": "用户账户",     "events": { "click": "on_tool_click" } },
        { "id": "tool_regedit", "type": "button", "page": 1, "rect": { "x": 8,   "y": 390, "w": 192, "h": 34 }, "text": "注册表编辑器", "events": { "click": "on_tool_click" } },
        { "id": "tool_cmd",     "type": "button", "page": 1, "rect": { "x": 206, "y": 390, "w": 192, "h": 34 }, "text": "命令提示符",   "events": { "click": "on_tool_click" } },
        { "id": "tool_ps",      "type": "button", "page": 1, "rect": { "x": 404, "y": 390, "w": 192, "h": 34 }, "text": "PowerShell",   "events": { "click": "on_tool_click" } },
        { "id": "tool_calc",    "type": "button", "page": 1, "rect": { "x": 602, "y": 390, "w": 192, "h": 34 }, "text": "计算器",       "events": { "click": "on_tool_click" } },
        { "id": "tool_notepad", "type": "button", "page": 1, "rect": { "x": 8,   "y": 432, "w": 192, "h": 34 }, "text": "记事本",       "events": { "click": "on_tool_click" } },
        { "id": "tool_mspaint", "type": "button", "page": 1, "rect": { "x": 206, "y": 432, "w": 192, "h": 34 }, "text": "画图",         "events": { "click": "on_tool_click" } },
        { "id": "tool_snip",    "type": "button", "page": 1, "rect": { "x": 404, "y": 432, "w": 192, "h": 34 }, "text": "截图工具",     "events": { "click": "on_tool_click" } },
        { "id": "tool_magnify", "type": "button", "page": 1, "rect": { "x": 602, "y": 432, "w": 192, "h": 34 }, "text": "放大镜",       "events": { "click": "on_tool_click" } },
        { "id": "lab_opt_hint", "type": "label", "page": 1, "rect": { "x": 8, "y": 478, "w": 804, "h": 34 },
          "text": "开关控制的是本工具箱自身行为。系统级开关（任务栏合并 / 内核隔离那种）要写系统注册表值并支持删值备份 —— 本工程注册表接口只能读写字符串值、没有删值与枚举，示例不碰系统键。", "style": "note" },

        { "id": "lab_sect_my", "type": "label", "page": 2, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
          "text": "  我的工具（编辑数据目录下 mytools.ini，加工具不用重编译）", "style": "sect" },
        { "id": "tool_my1", "type": "button", "page": 2, "rect": { "x": 8,   "y": 64, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my2", "type": "button", "page": 2, "rect": { "x": 206, "y": 64, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my3", "type": "button", "page": 2, "rect": { "x": 404, "y": 64, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my4", "type": "button", "page": 2, "rect": { "x": 602, "y": 64, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my5", "type": "button", "page": 2, "rect": { "x": 8,   "y": 106, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my6", "type": "button", "page": 2, "rect": { "x": 206, "y": 106, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my7", "type": "button", "page": 2, "rect": { "x": 404, "y": 106, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "tool_my8", "type": "button", "page": 2, "rect": { "x": 602, "y": 106, "w": 192, "h": 34 }, "text": "空槽位", "events": { "click": "on_tool_click" } },
        { "id": "btn_my_reload", "type": "button", "page": 2, "rect": { "x": 8,   "y": 148, "w": 192, "h": 34 },
          "text": "重新载入", "hint": "重读 mytools.ini 并刷新槽位",
          "events": { "click": "on_btn_my_reload_click" } },
        { "id": "btn_my_edit", "type": "button", "page": 2, "rect": { "x": 206, "y": 148, "w": 192, "h": 34 },
          "text": "编辑 mytools.ini", "hint": "没有就先生成带注释的模板，再用记事本打开",
          "events": { "click": "on_btn_my_edit_click" } },
        { "id": "lab_my_hint", "type": "label", "page": 2, "rect": { "x": 404, "y": 156, "w": 408, "h": 44 },
          "text": "首次点「编辑」会自动生成模板，里面 t1 是现成示例。", "style": "note" },
        { "id": "lab_my_fmt", "type": "label", "page": 2, "rect": { "x": 8, "y": 200, "w": 804, "h": 56 },
          "text": "mytools.ini 格式（8 个槽位 [t1]..[t8]）：\n  [t1]\n  name=显示的名字\ncmd=要执行的命令行\n空槽位灰着；name 或 cmd 留空都算空槽位。", "style": "note" },

        { "id": "lab_sect_dev", "type": "label", "page": 3, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
          "text": "  设备与硬件", "style": "sect" },
        { "id": "tool_devmgmt",  "type": "button", "page": 3, "rect": { "x": 8,   "y": 64, "w": 192, "h": 34 }, "text": "设备管理器",   "events": { "click": "on_tool_click" } },
        { "id": "tool_sound",    "type": "button", "page": 3, "rect": { "x": 206, "y": 64, "w": 192, "h": 34 }, "text": "声音",       "events": { "click": "on_tool_click" } },
        { "id": "tool_printer",  "type": "button", "page": 3, "rect": { "x": 404, "y": 64, "w": 192, "h": 34 }, "text": "设备和打印机", "events": { "click": "on_tool_click" } },
        { "id": "tool_tasks",    "type": "button", "page": 3, "rect": { "x": 602, "y": 64, "w": 192, "h": 34 }, "text": "计划任务",     "events": { "click": "on_tool_click" } },
        { "id": "tool_diskmgmt", "type": "button", "page": 3, "rect": { "x": 8,   "y": 106, "w": 192, "h": 34 }, "text": "磁盘管理",     "events": { "click": "on_tool_click" } },
        { "id": "tool_power",    "type": "button", "page": 3, "rect": { "x": 206, "y": 106, "w": 192, "h": 34 }, "text": "电源选项",     "events": { "click": "on_tool_click" } },
        { "id": "tool_display",  "type": "button", "page": 3, "rect": { "x": 404, "y": 106, "w": 192, "h": 34 }, "text": "显示设置",     "events": { "click": "on_tool_click" } },
        { "id": "tool_mouse",    "type": "button", "page": 3, "rect": { "x": 602, "y": 106, "w": 192, "h": 34 }, "text": "鼠标",         "events": { "click": "on_tool_click" } },
        { "id": "lab_sect_reg", "type": "label", "page": 3, "rect": { "x": 8, "y": 150, "w": 804, "h": 22 },
          "text": "  注册表 · 服务 · 策略", "style": "sect" },
        { "id": "tool_services", "type": "button", "page": 3, "rect": { "x": 8,   "y": 178, "w": 192, "h": 34 }, "text": "服务",         "events": { "click": "on_tool_click" } },
        { "id": "tool_gpedit",   "type": "button", "page": 3, "rect": { "x": 206, "y": 178, "w": 192, "h": 34 }, "text": "组策略",       "events": { "click": "on_tool_click" } },
        { "id": "tool_appwiz",   "type": "button", "page": 3, "rect": { "x": 404, "y": 178, "w": 192, "h": 34 }, "text": "程序和功能",   "events": { "click": "on_tool_click" } },
        { "id": "tool_firewall", "type": "button", "page": 3, "rect": { "x": 602, "y": 178, "w": 192, "h": 34 }, "text": "防火墙",       "events": { "click": "on_tool_click" } },
        { "id": "tool_sysdm",    "type": "button", "page": 3, "rect": { "x": 8,   "y": 220, "w": 192, "h": 34 }, "text": "系统属性",     "events": { "click": "on_tool_click" } },
        { "id": "tool_timedate", "type": "button", "page": 3, "rect": { "x": 206, "y": 220, "w": 192, "h": 34 }, "text": "日期和时间",   "events": { "click": "on_tool_click" } },
        { "id": "tool_defender", "type": "button", "page": 3, "rect": { "x": 404, "y": 220, "w": 192, "h": 34 }, "text": "Windows 安全中心", "events": { "click": "on_tool_click" } },
        { "id": "tool_update",   "type": "button", "page": 3, "rect": { "x": 602, "y": 220, "w": 192, "h": 34 }, "text": "Windows 更新", "events": { "click": "on_tool_click" } },
        { "id": "lab_sect_info", "type": "label", "page": 3, "rect": { "x": 8, "y": 264, "w": 804, "h": 22 },
          "text": "  系统信息与诊断", "style": "sect" },
        { "id": "tool_msinfo",   "type": "button", "page": 3, "rect": { "x": 8,   "y": 292, "w": 192, "h": 34 }, "text": "系统信息",     "events": { "click": "on_tool_click" } },
        { "id": "tool_dxdiag",   "type": "button", "page": 3, "rect": { "x": 206, "y": 292, "w": 192, "h": 34 }, "text": "DirectX 诊断", "events": { "click": "on_tool_click" } },
        { "id": "tool_winver",   "type": "button", "page": 3, "rect": { "x": 404, "y": 292, "w": 192, "h": 34 }, "text": "系统版本",     "events": { "click": "on_tool_click" } },
        { "id": "tool_resmon",   "type": "button", "page": 3, "rect": { "x": 602, "y": 292, "w": 192, "h": 34 }, "text": "资源监视器",   "events": { "click": "on_tool_click" } },
        { "id": "tool_perfmon",  "type": "button", "page": 3, "rect": { "x": 8,   "y": 334, "w": 192, "h": 34 }, "text": "性能监视器",   "events": { "click": "on_tool_click" } },
        { "id": "tool_eventvwr", "type": "button", "page": 3, "rect": { "x": 206, "y": 334, "w": 192, "h": 34 }, "text": "事件查看器",   "events": { "click": "on_tool_click" } },
        { "id": "tool_charmap",  "type": "button", "page": 3, "rect": { "x": 404, "y": 334, "w": 192, "h": 34 }, "text": "字符映射表",   "events": { "click": "on_tool_click" } },
        { "id": "tool_sndvol",   "type": "button", "page": 3, "rect": { "x": 602, "y": 334, "w": 192, "h": 34 }, "text": "音量合成器",   "events": { "click": "on_tool_click" } },

        { "id": "lab_sect_disk", "type": "label", "page": 4, "rect": { "x": 8, "y": 36, "w": 804, "h": 22 },
          "text": "  磁盘与空间", "style": "sect" },
        { "id": "tool_cleanmgr", "type": "button", "page": 4, "rect": { "x": 8,   "y": 64, "w": 192, "h": 34 }, "text": "磁盘清理", "events": { "click": "on_tool_click" } },
