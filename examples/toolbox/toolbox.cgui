        { "id": "tool_progs",     "type": "button", "page": 6, "rect": { "x": 206, "y": 106, "w": 192, "h": 34 }, "text": "程序安装目录", "events": { "click": "on_tool_click" } },
        { "id": "tool_appsflr",   "type": "button", "page": 6, "rect": { "x": 404, "y": 106, "w": 192, "h": 34 }, "text": "应用文件夹",   "events": { "click": "on_tool_click" } },
