        { "id": "rm0_on",  "type": "button", "page": 7, "rect": { "x": 8,   "y": 60, "w": 192, "h": 32 }, "text": "装上：复制文件路径",   "style": "install", "hint": "给所有文件的右键菜单加一条，复制文件完整路径到剪贴板", "events": { "click": "on_rmenu_click" } },
        { "id": "rm0_off", "type": "button", "page": 7, "rect": { "x": 206, "y": 60, "w": 192, "h": 32 }, "text": "撤掉", "style": "remove", "hint": "reg delete 整键删除，不留残留", "events": { "click": "on_rmenu_click" } },
        { "id": "lab_rm0", "type": "label", "page": 7, "rect": { "x": 404, "y": 66, "w": 408, "h": 20 }, "text": "", "style": "note" },
        { "id": "rm1_on",  "type": "button", "page": 7, "rect": { "x": 8,   "y": 98, "w": 192, "h": 32 }, "text": "装上：在此处打开终端", "style": "install", "hint": "文件夹空白处右键，就地打开命令提示符", "events": { "click": "on_rmenu_click" } },
        { "id": "rm1_off", "type": "button", "page": 7, "rect": { "x": 206, "y": 98, "w": 192, "h": 32 }, "text": "撤掉", "style": "remove", "hint": "reg delete 整键删除", "events": { "click": "on_rmenu_click" } },
        { "id": "lab_rm1", "type": "label", "page": 7, "rect": { "x": 404, "y": 104, "w": 408, "h": 20 }, "text": "", "style": "note" },
