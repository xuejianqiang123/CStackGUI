{
  "cgui": 1,
  "app": {
    "title": "帧协议解析器",
    "width": 980,
    "height": 660,
    "bg": "#F3EDF7",
    "events": {
      "close": "on_close",
      "destroy": "on_destroy"
    },
    "info": {
      "product": "CStackGUI 帧协议解析器",
      "desc": "自定义帧协议示例：AA 55 帧头 + 长度 + 命令 + 负载 + 校验（累加和 / XOR / CRC16），演示切帧、校验与解码，不接硬件",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "styles": {
    "label": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#1D1B20" },
    "input": { "font": "Microsoft YaHei UI", "size": 10 }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 634, "w": 980, "h": 26 },
      "items": ["就绪", "收 0 B", "成帧 0", "校验错 0", "残帧 0", "丢 0 B"]
    },
    {
      "id": "lab_title",
      "type": "label",
      "rect": { "x": 12, "y": 8, "w": 940, "h": 20 },
      "text": "帧 = [AA 55] [L] [cmd] [负载 N] [校验 1] ；L = 校验前的字节数 = 4 + N，整帧 = L + 1 字节"
    },
    {
      "id": "lab_proto",
      "type": "label",
      "rect": { "x": 12, "y": 30, "w": 956, "h": 22 },
      "text": "校验算式：累加和 = Σ(AA..负载) 取低 8 位 ；  XOR = 各字节逐位异或 ；  CRC16-Modbus = 初值 FFFF / 多项式 A001，低字节在前"
    },
    {
      "id": "lab_cmd",
      "type": "label",
      "rect": { "x": 12, "y": 62, "w": 36, "h": 24 },
      "text": "命令"
    },
    {
      "id": "spn_cmd",
      "type": "edit",
      "rect": { "x": 52, "y": 60, "w": 72, "h": 26 },
      "spin": true,
      "min": 0,
      "max": 255,
      "value": 1,
      "hint": "命令字节 cmd：01 读温度(int16) / 02 读量程(uint16) / 03 读电压组(int16[])，其它值只按十六进制显示"
    },
    {
      "id": "lab_pay",
      "type": "label",
      "rect": { "x": 134, "y": 62, "w": 54, "h": 24 },
      "text": "负载HEX"
    },
    {
      "id": "edt_pay",
      "type": "edit",
      "rect": { "x": 190, "y": 60, "w": 180, "h": 26 },
      "text": "0A 0B",
      "hint": "负载字节，像「0A 0B」。是 int16 的地方按下面的「字节序」解；空负载就填 0 字节",
      "events": { "change": "on_change" }
    },
    {
      "id": "cmb_sum",
      "type": "combo",
      "rect": { "x": 422, "y": 58, "w": 150, "h": 200 },
      "items": ["累加和(低8位)", "XOR", "CRC16-Modbus"],
      "value": 0,
      "hint": "校验类型（帧里只放 1 字节）：累加和取低 8 位 / 逐字节异或 / CRC16-Modbus 的低字节（低字节在前）",
      "events": { "select": "on_change" }
    },
    {
      "id": "cmb_end",
      "type": "combo",
      "rect": { "x": 638, "y": 58, "w": 90, "h": 200 },
      "items": ["小端", "大端"],
      "value": 1,
      "hint": "解码负载时的字节序：小端 = 低字节在前，大端 = 高字节在前",
      "events": { "select": "on_change" }
    },
    {
      "id": "btn_mock",
      "type": "button",
      "rect": { "x": 740, "y": 58, "w": 110, "h": 30 },
      "text": "模拟一帧",
      "hint": "按当前校验 / 命令 / 负载拼一帧，把十六进制填进下面的输入框（只填不发）",
      "events": { "click": "on_mock" }
    },
    {
      "id": "btn_burst",
      "type": "button",
      "rect": { "x": 856, "y": 58, "w": 112, "h": 30 },
      "text": "模拟连发",
      "hint": "每 300ms 造一批字节喂进切帧器：2 字节噪声 + 一帧合法帧 + 一段断帧，演示切帧的健壮性",
      "events": { "click": "on_burst" }
    },
    {
      "id": "btn_feed",
      "type": "button",
      "rect": { "x": 12, "y": 94, "w": 152, "h": 30 },
      "text": "喂入输入的十六进制",
      "hint": "把下面输入框里的十六进制文本解析成字节，喂进切帧器（空格 / 换行 / 逗号都能忍）",
      "events": { "click": "on_feed" }
    },
    {
      "id": "btn_reset",
      "type": "button",
      "rect": { "x": 172, "y": 94, "w": 110, "h": 30 },
      "text": "清空 / 重置",
      "hint": "丢掉还没切出的半帧，清空统计、帧表与日志",
      "events": { "click": "on_reset" }
    },
    {
      "id": "lab_hint",
      "type": "label",
      "rect": { "x": 294, "y": 100, "w": 674, "h": 20 },
      "text": "输入框里可粘贴：AA 55 06 01 0A 0B 1B（帧头 + 长度 + 命令 + 负载 + 校验，带空格换行都能忍）"
    },
    {
      "id": "grp_left",
      "type": "group",
      "rect": { "x": 8, "y": 132, "w": 560, "h": 490 },
      "text": "十六进制输入 / 切出的帧表",
      "children": [
        {
          "id": "edt_hex",
          "type": "edit",
          "rect": { "x": 12, "y": 26, "w": 536, "h": 150 },
          "text": "AA 55 06 01 0A 0B 1B",
          "multiline": true,
          "scroll": 2,
          "hint": "粘贴 AA 55 04 01 4B 这样的十六进制；空格 / 换行 / 逗号都当分隔符",
          "events": { "submit": "on_feed" }
        },
        {
          "id": "tbl_frames",
          "type": "table",
          "rect": { "x": 12, "y": 206, "w": 536, "h": 270 },
          "hint": "合法帧进这里（含解码结果）；校验错的帧也进，结论列写清算出多少、帧里多少。列由程序建"
        }
      ]
    },
    {
      "id": "sp_mid",
      "type": "splitter",
      "rect": { "x": 570, "y": 132, "w": 6, "h": 490 },
      "format": "col",
      "hint": "左右拖动：左边（输入 / 帧表）与右边（日志）分配宽度"
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 584, "y": 132, "w": 388, "h": 490 },
      "grow": 1,
      "checked": true,
      "value": 800,
      "items": [
        "帧协议解析器：AA 55 帧头 + 长度 + 命令 + 负载 + 校验。",
        "点「模拟一帧」生成一帧，再点「喂入」看它被切出来；或点「模拟连发」看噪声与断帧怎么处理。"
      ]
    }
  ]
}
