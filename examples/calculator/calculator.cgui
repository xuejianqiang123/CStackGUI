{
  "cgui": 1,
  "app": {
    "title": "计算器",
    "width": 840,
    "height": 492,
    "bg": "#F3EDF7",
    "info": {
      "product": "计算器",
      "desc": "表达式求值 / 时间戳转换 / 进制转换 / 长度计算 / 字符串转换 / 位运算拼接",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": {
        "x": 0,
        "y": 466,
        "w": 840,
        "h": 24
      },
      "items": [
        "就绪",
        "计算 / 时间戳 / 进制 / 长度 / 字符串 / 位运算"
      ]
    },
    {
      "id": "grp_calc",
      "type": "group",
      "rect": {
        "x": 8,
        "y": 8,
        "w": 470,
        "h": 124
      },
      "text": "计算",
      "hint": "表达式求值：四则、括号、幂、位运算与常用函数",
      "children": [
        {
          "id": "lab_expr",
          "type": "label",
          "rect": {
            "x": 14,
            "y": 28,
            "w": 56,
            "h": 24
          },
          "text": "计算式："
        },
        {
          "id": "edt_expr",
          "type": "edit",
          "rect": {
            "x": 76,
            "y": 26,
            "w": 250,
            "h": 26
          },
          "hint": "如 (1+2)*3-4/2、0xff&0x0f、sqrt(2)",
          "events": {
            "change": "on_expr_change"
          }
        },
        {
          "id": "btn_calc",
          "type": "button",
          "rect": {
            "x": 334,
            "y": 25,
            "w": 112,
            "h": 30
          },
          "text": "计算",
          "hint": "按语法求值，结果显示在下面",
          "events": {
            "click": "on_calc_click"
          }
        },
        {
          "id": "lab_result",
          "type": "label",
          "rect": {
            "x": 14,
            "y": 66,
            "w": 56,
            "h": 24
          },
          "text": "结果："
        },
        {
          "id": "edt_result",
          "type": "edit",
          "rect": {
            "x": 76,
            "y": 64,
            "w": 250,
            "h": 26
          }
        },
        {
          "id": "btn_formula",
          "type": "button",
          "rect": {
            "x": 334,
            "y": 63,
            "w": 112,
            "h": 30
          },
          "text": "查看公式",
          "hint": "把支持的运算符与函数清单写进结果框",
          "events": {
            "click": "on_formula_click"
          }
        },
        {
          "id": "lab_calc_hint",
          "type": "label",
          "rect": {
            "x": 14,
            "y": 96,
            "w": 432,
            "h": 20
          },
          "text": "改完计算式回车即算；语法见「查看公式」",
          "style": {
            "font": "Microsoft YaHei UI",
            "size": 9
          }
        }
      ]
    },
    {
      "id": "grp_time",
      "type": "group",
      "rect": {
        "x": 490,
        "y": 8,
        "w": 342,
        "h": 124
      },
      "text": "时间戳",
      "hint": "unix 秒与 UTC 文本互转",
      "children": [
        {
          "id": "btn_gen_ts",
          "type": "button",
          "rect": {
            "x": 14,
            "y": 24,
            "w": 314,
            "h": 34
          },
          "text": "点击生成时间戳(自动复)",
          "hint": "取当前 unix 秒写入左框，并复制到剪贴板",
          "events": {
            "click": "on_gen_ts_click"
          }
        },
        {
          "id": "edt_ts",
          "type": "edit",
          "rect": {
            "x": 14,
            "y": 64,
            "w": 148,
            "h": 26
          },
          "hint": "unix 秒，如 1762886400",
          "events": {
            "change": "on_ts_change"
          }
        },
        {
          "id": "edt_utc",
          "type": "edit",
          "rect": {
            "x": 170,
            "y": 64,
            "w": 158,
            "h": 26
          },
          "hint": "YYYY-MM-DD HH:MM:SS",
          "events": {
            "change": "on_utc_change"
          }
        },
        {
          "id": "btn_ts2utc",
          "type": "button",
          "rect": {
            "x": 14,
            "y": 96,
            "w": 148,
            "h": 24
          },
          "text": "时间戳->UTC",
          "hint": "左框时间戳转成 UTC 文本写右框",
          "events": {
            "click": "on_ts2utc_click"
          }
        },
        {
          "id": "btn_utc2ts",
          "type": "button",
          "rect": {
            "x": 170,
            "y": 96,
            "w": 158,
            "h": 24
          },
          "text": "UTC->时间戳",
          "hint": "右框 UTC 文本转成时间戳写左框",
          "events": {
            "click": "on_utc2ts_click"
          }
        }
      ]
    },
