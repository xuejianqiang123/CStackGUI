{
  "cgui": 1,
  "app": {
    "title": "CStackGUI 最小闭环示例",
    "width": 700,
    "height": 500,
    "bg": "#F3EDF7"
  },
  "widgets": [
    {
      "id": "grp_user",
      "type": "group",
      "rect": { "x": 24, "y": 24, "w": 300, "h": 180 },
      "text": "个人信息",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#1D1B20" },
      "children": [
        {
          "id": "lab_name",
          "type": "label",
          "rect": { "x": 16, "y": 36, "w": 56, "h": 26 },
          "text": "姓名",
          "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#49454F" }
        },
        {
          "id": "edt_name",
          "type": "edit",
          "rect": { "x": 80, "y": 32, "w": 196, "h": 28 },
          "text": "",
          "events": { "change": "on_name_change", "submit": "on_name_submit" }
        },
        {
          "id": "chk_vip",
          "type": "checkbox",
          "rect": { "x": 16, "y": 76, "w": 150, "h": 26 },
          "text": "VIP 用户",
          "events": { "change": "on_vip_change" }
        },
        {
          "id": "sld_level",
          "type": "slider",
          "rect": { "x": 16, "y": 112, "w": 260, "h": 32 },
          "value": 40,
          "min": 0,
          "max": 100,
          "events": { "change": "on_level_change" }
        },
        {
          "id": "lab_level",
          "type": "label",
          "rect": { "x": 16, "y": 148, "w": 260, "h": 22 },
          "text": "等级 40",
          "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#49454F" }
        }
      ]
    },
    {
      "id": "lab_title",
      "type": "label",
      "rect": { "x": 348, "y": 24, "w": 330, "h": 32 },
      "text": "CStackGUI 演示",
      "style": { "font": "Microsoft YaHei UI", "size": 16, "bold": true, "fg": "#6750A4" }
    },
    {
      "id": "lab_status",
      "type": "label",
      "rect": { "x": 348, "y": 64, "w": 330, "h": 24 },
      "text": "就绪：界面由 hello.cgui 描述，逻辑在 main.c",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#1D1B20" }
    },
    {
      "id": "prg_level",
      "type": "progress",
      "rect": { "x": 348, "y": 100, "w": 330, "h": 18 },
      "value": 40,
      "min": 0,
      "max": 100
    },
    {
      "id": "lst_log",
      "type": "listbox",
      "rect": { "x": 348, "y": 132, "w": 330, "h": 220 }
    },
    {
      "id": "btn_ok",
      "type": "button",
      "rect": { "x": 348, "y": 372, "w": 200, "h": 44 },
      "text": "确定（单击 / 双击）",
      "style": { "font": "Microsoft YaHei UI", "size": 10 },
      "events": { "click": "on_ok_click", "dblclick": "on_ok_dblclick" }
    },
    {
      "id": "btn_reset",
      "type": "button",
      "rect": { "x": 560, "y": 372, "w": 118, "h": 44 },
      "text": "重置",
      "style": { "font": "Microsoft YaHei UI", "size": 10 },
      "events": { "click": "on_reset_click" }
    },
    {
      "id": "btn_quit",
      "type": "button",
      "rect": { "x": 348, "y": 428, "w": 330, "h": 40 },
      "text": "退出",
      "style": { "font": "Microsoft YaHei UI", "size": 10 },
      "events": { "click": "on_quit_click" }
    }
  ]
}
