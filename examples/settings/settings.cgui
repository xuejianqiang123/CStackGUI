{
  "cgui": 1,
  "app": {
    "title": "设置持久化",
    "width": 900,
    "height": 616,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 设置持久化",
      "desc": "INI / 注册表 HKCU / 用户数据目录文件 三个后端并排对比",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_back",
      "type": "statusbar",
      "rect": { "x": 0, "y": 592, "w": 900, "h": 24 },
      "items": ["当前后端：INI 文件", "对比表：尚未刷新", "就绪"]
    },
    {
      "id": "lab_dir",
      "type": "label",
      "rect": { "x": 12, "y": 16, "w": 76, "h": 24 },
      "text": "上次目录"
    },
    {
      "id": "edt_dir",
      "type": "edit",
      "rect": { "x": 92, "y": 14, "w": 176, "h": 28 },
      "maxlen": 200,
      "hint": "上次打开的目录（文本设置项）"
    },
    {
      "id": "lab_font",
      "type": "label",
      "rect": { "x": 276, "y": 16, "w": 40, "h": 24 },
      "text": "字号"
    },
    {
      "id": "edt_font",
      "type": "edit",
      "rect": { "x": 318, "y": 14, "w": 84, "h": 28 },
      "spin": true,
      "min": 8,
      "max": 28,
      "value": 14,
      "hint": "整数设置项：带调节器的数值框（8..28）；读回时越界会回退默认值"
    },
    {
      "id": "chk_dark",
      "type": "checkbox",
      "rect": { "x": 414, "y": 14, "w": 120, "h": 28 },
      "text": "深色主题",
      "checked": false
    },
    {
      "id": "lab_recent",
      "type": "label",
      "rect": { "x": 540, "y": 16, "w": 72, "h": 24 },
      "text": "最近文件"
    },
    {
      "id": "edt_recent1",
      "type": "edit",
      "rect": { "x": 616, "y": 14, "w": 90, "h": 28 },
      "maxlen": 120
    },
    {
      "id": "edt_recent2",
      "type": "edit",
      "rect": { "x": 712, "y": 14, "w": 90, "h": 28 },
      "maxlen": 120
    },
    {
      "id": "edt_recent3",
      "type": "edit",
      "rect": { "x": 808, "y": 14, "w": 90, "h": 28 },
      "maxlen": 120,
      "hint": "最近使用的 3 个文件名（整组一起存 / 一起读）"
    },
    {
      "id": "lab_backend",
      "type": "label",
      "rect": { "x": 12, "y": 56, "w": 76, "h": 24 },
      "text": "存储后端"
    },
    {
      "id": "cmb_backend",
      "type": "combo",
      "rect": { "x": 92, "y": 52, "w": 240, "h": 28 },
      "items": ["INI 文件", "注册表 HKCU", "用户数据目录文件"],
      "value": 0,
      "hint": "选哪个，右边的保存 / 读取 / 清空就作用于哪个",
      "events": { "select": "on_cmb_backend_select" }
    },
    {
      "id": "btn_save",
      "type": "button",
      "rect": { "x": 344, "y": 52, "w": 110, "h": 28 },
      "text": "保存",
      "hint": "把上面这组设置写进当前后端",
      "events": { "click": "on_btn_save_click" }
    },
    {
      "id": "btn_load",
      "type": "button",
      "rect": { "x": 464, "y": 52, "w": 110, "h": 28 },
      "text": "读取",
      "hint": "从当前后端读回设置；缺字段 / 脏数据回退默认值",
      "events": { "click": "on_btn_load_click" }
    },
    {
      "id": "btn_clear",
      "type": "button",
      "rect": { "x": 584, "y": 52, "w": 110, "h": 28 },
      "text": "清空",
      "hint": "删文件；注册表没有删值接口，改写空串（值空 = 相当于没设）",
      "events": { "click": "on_btn_clear_click" }
    },
    {
      "id": "lab_loc",
      "type": "label",
      "rect": { "x": 706, "y": 56, "w": 182, "h": 24 },
      "text": "（启动时确定）"
    },
    {
      "id": "lab_tbl",
      "type": "label",
      "rect": { "x": 12, "y": 92, "w": 876, "h": 24 },
      "text": "三个后端各自现在存着什么（换后端保存后，旧后端的值仍留在原处）"
    },
    {
      "id": "tbl_back",
      "type": "table",
      "rect": { "x": 12, "y": 118, "w": 876, "h": 168 },
      "columns": [
        { "title": "后端", "w": 130 },
        { "title": "位置摘要", "w": 320 },
        { "title": "字号", "w": 90 },
        { "title": "深色", "w": 90 },
        { "title": "更新时间 / 不存在" }
      ]
    },
    {
      "id": "lab_log",
      "type": "label",
      "rect": { "x": 12, "y": 302, "w": 876, "h": 24 },
      "text": "操作日志"
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 12, "y": 328, "w": 876, "h": 252 },
      "checked": true,
      "value": 500,
      "hint": "每次保存 / 读取 / 清空都会在这里留一行"
    }
  ]
}
