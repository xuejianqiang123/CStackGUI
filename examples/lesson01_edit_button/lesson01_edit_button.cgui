{
  "cgui": 1,
  "app": {
    "title": "入门01 编辑框和按钮",
    "width": 420,
    "height": 320,
    "bg": "#F3EDF7"
  },
  "widgets": [
    {
      "id": "lab_tip",
      "type": "label",
      "rect": { "x": 16, "y": 16, "w": 388, "h": 24 },
      "text": "在下面输入名字，然后点「打招呼」。",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#49454F" }
    },
    {
      "id": "edt_name",
      "type": "edit",
      "rect": { "x": 16, "y": 48, "w": 388, "h": 34 },
      "text": "",
      "style": { "font": "Microsoft YaHei UI", "size": 10 },
      "hint": "输入名字后按回车，等于点「打招呼」",
      "events": { "change": "on_input_change", "submit": "on_hello_submit" }
    },
    {
      "id": "btn_hello",
      "type": "button",
      "rect": { "x": 16, "y": 100, "w": 130, "h": 40 },
      "text": "打招呼",
      "hint": "读输入框里的名字，显示到下面",
      "events": { "click": "on_button_click" }
    },
    {
      "id": "btn_clear",
      "type": "button",
      "rect": { "x": 158, "y": 100, "w": 130, "h": 40 },
      "text": "清空",
      "hint": "清空输入框和结果",
      "events": { "click": "on_button_click" }
    },
    {
      "id": "lab_result",
      "type": "label",
      "rect": { "x": 16, "y": 160, "w": 388, "h": 110 },
      "text": "（结果显示在这里）",
      "style": { "font": "Microsoft YaHei UI", "size": 11, "fg": "#6750A4" }
    },
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 296, "w": 420, "h": 24 },
      "items": ["就绪"]
    }
  ]
}
