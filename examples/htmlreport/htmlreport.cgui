{
  "cgui": 1,
  "app": {
    "title": "HTML 报告器",
    "width": 1080,
    "height": 700,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI HTML 报告",
      "desc": "把 CSV 生成离线可看的 HTML 报告（内嵌 CSS / 无 JavaScript / 单元格转义）；网页控件预览，也可交给系统默认浏览器",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    },
    "events": { "close": "on_close" }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 676, "w": 1080, "h": 24 },
      "items": ["等待数据", "0 列 × 0 行", "报告：还没生成"]
    },
    {
      "id": "btn_open",
      "type": "button",
      "rect": { "x": 12, "y": 12, "w": 158, "h": 34 },
      "text": "打开 CSV...",
      "hint": "选一个首行是表头的 CSV。超过 8 MB 只取前一段，数据行封顶 5000 行；不处理引号转义",
      "events": { "click": "on_btn_open_click" }
    },
    {
      "id": "btn_gen",
      "type": "button",
      "rect": { "x": 178, "y": 12, "w": 158, "h": 34 },
      "text": "生成并预览",
      "hint": "写进用户数据目录（首块覆盖写、其后追加），然后让网页控件加载它",
      "events": { "click": "on_btn_generate_click" }
    },
    {
      "id": "btn_sys",
      "type": "button",
      "rect": { "x": 344, "y": 12, "w": 190, "h": 34 },
      "text": "用系统默认浏览器打开",
      "hint": "把报告文件交给系统默认程序（网页控件起不来时的兜底）",
      "events": { "click": "on_btn_sysopen_click" }
    },
    {
      "id": "btn_copy",
      "type": "button",
      "rect": { "x": 542, "y": 12, "w": 158, "h": 34 },
      "text": "复制 HTML 源码",
      "hint": "把完整 HTML 放进剪贴板（上限 256 KB，超了截断）",
      "events": { "click": "on_btn_copy_click" }
    },
    {
      "id": "web_view",
      "type": "browser",
      "rect": { "x": 12, "y": 54, "w": 1056, "h": 470 },
      "grow": 1,
      "hint": "网页控件是实验性功能，起不来会降级成空占位 —— 那时点「用系统默认浏览器打开」"
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 12, "y": 530, "w": 1056, "h": 140 },
      "hint": "日志：读数据 / 生成 / 打开报告的过程都写在这里"
    }
  ]
}
