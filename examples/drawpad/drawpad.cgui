{
  "cgui": 1,
  "app": {
    "title": "画板",
    "width": 760,
    "height": 620,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 画板",
      "desc": "鼠标拖拽作图、撤销 / 重做、导出 PNG；绘制命令被录制、重绘时按序回放",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 596, "w": 760, "h": 24 },
      "items": ["工具：直线", "已画 0 笔", "就绪"]
    },
    {
      "id": "lab_tool",
      "type": "label",
      "rect": { "x": 12, "y": 14, "w": 56, "h": 24 },
      "text": "工具"
    },
    {
      "id": "cbo_tool",
      "type": "combo",
      "rect": { "x": 72, "y": 10, "w": 148, "h": 32 },
      "items": ["直线", "矩形", "椭圆", "文字", "自由笔"],
      "value": 0,
      "hint": "下标 0..4 = 直线 / 矩形 / 椭圆 / 文字 / 自由笔"
    },
    {
      "id": "lab_ink",
      "type": "label",
      "rect": { "x": 232, "y": 14, "w": 36, "h": 24 },
      "text": "颜色"
    },
    {
      "id": "cp_ink",
      "type": "colorpicker",
      "rect": { "x": 272, "y": 12, "w": 60, "h": 28 },
      "value": 1973790,
      "hint": "当前色存在 value（0xRRGGBB）；点它弹系统取色器"
    },
    {
      "id": "lab_pen",
      "type": "label",
      "rect": { "x": 344, "y": 14, "w": 36, "h": 24 },
      "text": "笔宽"
    },
    {
      "id": "edt_pen",
      "type": "edit",
      "rect": { "x": 384, "y": 12, "w": 64, "h": 28 },
      "value": 2,
      "min": 1,
      "max": 12,
      "spin": true,
      "input": 7,
      "hint": "带调节器的数值框，笔宽 1..12"
    },
    {
      "id": "btn_undo",
      "type": "button",
      "rect": { "x": 460, "y": 10, "w": 64, "h": 30 },
      "text": "撤销",
      "hint": "丢掉最后一条命令，再清空记录重放剩下的",
      "events": { "click": "on_edit_op" }
    },
    {
      "id": "btn_redo",
      "type": "button",
      "rect": { "x": 530, "y": 10, "w": 64, "h": 30 },
      "text": "重做",
      "hint": "把刚撤销的那条再放回去",
      "events": { "click": "on_edit_op" }
    },
    {
      "id": "btn_clear",
      "type": "button",
      "rect": { "x": 600, "y": 10, "w": 64, "h": 30 },
      "text": "清空",
      "hint": "丢掉全部命令并清空画板",
      "events": { "click": "on_edit_op" }
    },
    {
      "id": "btn_export",
      "type": "button",
      "rect": { "x": 670, "y": 10, "w": 78, "h": 30 },
      "text": "导出 PNG",
      "hint": "把画板截图存进用户数据目录（文件名带时间戳）",
      "events": { "click": "on_export" }
    },
    {
      "id": "cv_board",
      "type": "canvas",
      "rect": { "x": 12, "y": 54, "w": 736, "h": 372 },
      "style": { "bg": "#FFFFFF" },
      "hint": "在画板上按下并拖动即作图；图形是被录制的绘制命令，重绘时按序回放",
      "events": {
        "mousedown": "on_board_mouse",
        "mousemove": "on_board_mouse",
        "mouseup": "on_board_mouse"
      }
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 12, "y": 434, "w": 736, "h": 138 },
      "checked": true,
      "value": 500,
      "hint": "每一步作图 / 撤销 / 导出都记一行"
    }
  ]
}
