{
  "cgui": 1,
  "app": {
    "title": "CStackGUI 控件陈列室",
    "width": 900,
    "height": 860,
    "bg": "#F3EDF7",
    "events": { "close": "on_close" }
  },
  "widgets": [
    {
      "id": "menu_main",
      "type": "menu",
      "events": { "click": "on_menu_click" },
      "nodes": [
        {
          "text": "文件",
          "children": [
            { "text": "新建", "id": "m_new" },
            { "text": "打开", "id": "m_open" },
            { "text": "保存", "id": "m_save" },
            { "text": "-" },
            { "text": "退出", "id": "m_quit" }
          ]
        },
        {
          "text": "编辑",
          "children": [
            { "text": "复制", "id": "m_copy" },
            { "text": "粘贴", "id": "m_paste" }
          ]
        },
        {
          "text": "视图",
          "children": [
            { "text": "状态栏", "id": "m_status", "checked": true },
            { "text": "关于", "id": "m_about" }
          ]
        }
      ]
    },
    {
      "id": "tb_main",
      "type": "toolbar",
      "rect": { "x": 0, "y": 0, "w": 900, "h": 34 },
      "items": ["新建", "打开", "保存", "关于"],
      "events": { "click": "on_toolbar_click" }
    },
    {
      "id": "mbtn_more",
      "type": "menubutton",
      "rect": { "x": 12, "y": 46, "w": 120, "h": 30 },
      "text": "更多操作",
      "style": { "font": "Microsoft YaHei UI", "size": 9 },
      "events": { "click": "on_more_click" },
      "nodes": [
        { "text": "导出为 CSV", "id": "x_csv" },
        { "text": "导出为 JSON", "id": "x_json" },
        { "text": "-" },
        { "text": "清空全部", "id": "x_clear" }
      ]
    },
    {
      "id": "lab_mbtn_hint",
      "type": "label",
      "rect": { "x": 142, "y": 50, "w": 260, "h": 22 },
      "text": "菜单按钮：点一下在下方弹出菜单",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "sw_notify",
      "type": "switch",
      "rect": { "x": 12, "y": 90, "w": 180, "h": 32 },
      "text": "通知",
      "checked": true,
      "events": { "change": "on_notify_change" }
    },
    {
      "id": "spn_count",
      "type": "spinner",
      "rect": { "x": 12, "y": 134, "w": 110, "h": 28 },
      "value": 5,
      "min": 0,
      "max": 100,
      "events": { "change": "on_count_change" }
    },
    {
      "id": "lab_count",
      "type": "label",
      "rect": { "x": 132, "y": 138, "w": 150, "h": 24 },
      "text": "数量 5（联动右边圆环）",
      "style": { "font": "Microsoft YaHei UI", "size": 9 }
    },
    {
      "id": "dt_date",
      "type": "datepicker",
      "rect": { "x": 12, "y": 174, "w": 150, "h": 28 },
      "format": "date",
      "text": "2026-09-19",
      "events": { "change": "on_date_change" }
    },
    {
      "id": "dt_time",
      "type": "datepicker",
      "rect": { "x": 172, "y": 174, "w": 120, "h": 28 },
      "format": "time",
      "text": "14:30",
      "events": { "change": "on_time_change" }
    },
    {
      "id": "dt_both",
      "type": "datepicker",
      "rect": { "x": 12, "y": 214, "w": 280, "h": 28 },
      "format": "datetime",
      "text": "2026-09-19 14:30",
      "events": { "change": "on_datetime_change" }
    },
    {
      "id": "lab_dt_hint",
      "type": "label",
      "rect": { "x": 12, "y": 250, "w": 300, "h": 22 },
      "text": "日期 / 时间 / 日期+时间（后者是两个控件拼的）",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "tree_files",
      "type": "tree",
      "rect": { "x": 12, "y": 280, "w": 300, "h": 166 },
      "events": {
        "select": "on_tree_select",
        "dblclick": "on_tree_dblclick",
        "expand": "on_tree_expand",
        "collapse": "on_tree_collapse"
      },
      "nodes": [
        {
          "text": "项目",
          "expanded": true,
          "children": [
            { "text": "runtime" },
            { "text": "designer" },
            { "text": "examples" }
          ]
        },
        {
          "text": "构建产物",
          "children": [
            { "text": "hello.exe" },
            { "text": "gallery.exe" }
          ]
        }
      ]
    },
    {
      "id": "lab_tree_sel",
      "type": "label",
      "rect": { "x": 12, "y": 452, "w": 300, "h": 22 },
      "text": "树：未选中",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#6750A4" }
    },
    {
      "id": "btn_add_node",
      "type": "button",
      "rect": { "x": 12, "y": 480, "w": 146, "h": 36 },
      "text": "给树加节点",
      "style": { "font": "Microsoft YaHei UI", "size": 9 },
      "events": { "click": "on_add_node" }
    },
    {
      "id": "btn_add_row",
      "type": "button",
      "rect": { "x": 166, "y": 480, "w": 146, "h": 36 },
      "text": "给表格加行",
      "style": { "font": "Microsoft YaHei UI", "size": 9 },
      "events": { "click": "on_add_row" }
    },
    {
      "id": "lnk_docs",
      "type": "link",
      "rect": { "x": 12, "y": 532, "w": 180, "h": 24 },
      "text": "打开帮助文档（链接）",
      "events": { "click": "on_link_click" }
    },
    {
      "id": "lab_link_hint",
      "type": "label",
      "rect": { "x": 12, "y": 560, "w": 300, "h": 22 },
      "text": "链接：手型光标 + 下划线，只支持 click / dblclick",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "icb_run",
      "type": "iconbutton",
      "rect": { "x": 12, "y": 588, "w": 52, "h": 52 },
      "src": "assets/icon.png",
      "events": { "click": "on_icon_click" }
    },
    {
      "id": "lab_icon_hint",
      "type": "label",
      "rect": { "x": 74, "y": 602, "w": 240, "h": 24 },
      "text": "图标按钮：src 指定图片",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "img_logo",
      "type": "image",
      "rect": { "x": 340, "y": 46, "w": 250, "h": 90 },
      "src": "assets/logo.png"
    },
    {
      "id": "rt_notes",
      "type": "richtext",
      "rect": { "x": 606, "y": 46, "w": 282, "h": 90 },
      "text": "富文本：能装大段文字，\r\n也可以当简易编辑器用。",
      "events": { "change": "on_richtext_change" }
    },
    {
      "id": "tabs_main",
      "type": "tabs",
      "rect": { "x": 340, "y": 150, "w": 548, "h": 200 },
      "value": 0,
      "items": ["页面一", "页面二"],
      "events": { "select": "on_tab_change" },
      "children": [
        {
          "id": "lab_p1",
          "type": "label",
          "rect": { "x": 16, "y": 42, "w": 500, "h": 24 },
          "text": "标签页里的子控件，坐标相对标签页客户区",
          "style": { "font": "Microsoft YaHei UI", "size": 9 },
          "page": 0
        },
        {
          "id": "edt_p1",
          "type": "edit",
          "rect": { "x": 16, "y": 76, "w": 320, "h": 30 },
          "events": { "change": "on_p1_change" },
          "page": 0
        },
        {
          "id": "btn_p1",
          "type": "button",
          "rect": { "x": 350, "y": 76, "w": 150, "h": 30 },
          "text": "看输入框内容",
          "style": { "font": "Microsoft YaHei UI", "size": 9 },
          "events": { "click": "on_p1_click" },
          "page": 0
        },
        {
          "id": "lab_p2",
          "type": "label",
          "rect": { "x": 16, "y": 42, "w": 500, "h": 24 },
          "text": "切页时这一页的控件才显示",
          "style": { "font": "Microsoft YaHei UI", "size": 9 },
          "page": 1
        },
        {
          "id": "chk_p2",
          "type": "checkbox",
          "rect": { "x": 16, "y": 76, "w": 240, "h": 28 },
          "text": "第二页的复选框",
          "events": { "change": "on_p2_check" },
          "page": 1
        }
      ]
    },
    {
      "id": "tbl_data",
      "type": "table",
      "rect": { "x": 340, "y": 364, "w": 548, "h": 152 },
      "events": { "select": "on_table_select" },
      "columns": [
        { "title": "姓名", "w": 140 },
        { "title": "年龄", "w": 80 },
        { "title": "城市" }
      ],
      "rows": [
        ["张三", "28", "上海"],
        ["李四", "34", "成都"]
      ]
    },
    {
      "id": "ring_count",
      "type": "progressring",
      "rect": { "x": 340, "y": 540, "w": 130, "h": 130 },
      "value": 5,
      "min": 0,
      "max": 100
    },
    {
      "id": "lab_ring_hint",
      "type": "label",
      "rect": { "x": 340, "y": 678, "w": 130, "h": 40 },
      "text": "圆环进度（自绘）：跟着微调框走",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "cal_date",
      "type": "monthcal",
      "rect": { "x": 500, "y": 540, "w": 230, "h": 170 },
      "events": { "select": "on_cal_select" }
    },
    {
      "id": "lab_cal_hint",
      "type": "label",
      "rect": { "x": 500, "y": 716, "w": 380, "h": 22 },
      "text": "月历：点某天会把日期写回 text，只支持 select",
      "style": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#79747E" }
    },
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 834, "w": 900, "h": 26 },
      "items": ["就绪", "点个控件试试"]
    }
  ]
}
