{
  "cgui": 1,
  "app": {
    "title": "CStackGUI 控件陈列室",
    "width": 900,
    "height": 860,
    "bg": "#F3EDF7",
    "events": {
      "close": "on_close"
    }
  },
  "widgets": [
    {
      "id": "menu_main",
      "type": "menu",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 0,
        "h": 0
      },
      "nodes": [
        {
          "text": "文件",
          "children": [
            {
              "text": "新建",
              "id": "m_new"
            },
            {
              "text": "打开",
              "id": "m_open"
            },
            {
              "text": "保存",
              "id": "m_save"
            },
            {
              "text": "-"
            },
            {
              "text": "退出",
              "id": "m_quit"
            }
          ]
        },
        {
          "text": "编辑",
          "children": [
            {
              "text": "复制",
              "id": "m_copy"
            },
            {
              "text": "粘贴",
              "id": "m_paste"
            }
          ]
        },
        {
          "text": "视图",
          "children": [
            {
              "text": "状态栏",
              "id": "m_status",
              "checked": true
            },
            {
              "text": "关于",
              "id": "m_about"
            }
          ]
        }
      ],
      "events": {
        "click": "on_menu_click"
      }
    },
    {
      "id": "tb_main",
      "type": "toolbar",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 900,
        "h": 34
      },
      "items": [
        "新建",
        "打开",
        "保存",
        "关于"
      ],
      "events": {
        "click": "on_toolbar_click"
      }
    },
    {
      "id": "pages_main",
      "type": "tabs",
      "rect": {
        "x": 8,
        "y": 44,
        "w": 884,
        "h": 780
      },
      "items": [
        "基础闭环",
        "控件陈列",
        "新特性"
