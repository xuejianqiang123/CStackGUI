@echo off
rem Build entry for this project (generated by the repo-root build-app.bat).
rem The real build logic lives in the repo-root build-app.bat, so the two never drift.
setlocal
if "%CSTACKGUI_HOME%"=="" set CSTACKGUI_HOME=%~dp0..\..
if not exist "%CSTACKGUI_HOME%\build-app.bat" (
    echo [fail] project root not found: %CSTACKGUI_HOME%
    echo        set CSTACKGUI_HOME to the CStackGUI root dir (the one with runtime\ and apps\)
    exit /b 1
)
rem The project name is THIS folder's name, so renaming the folder is fine.
for %%I in ("%~dp0.") do set CG_APP=%%~nI
call "%CSTACKGUI_HOME%\build-app.bat" %CG_APP% %*
exit /b %errorlevel%
