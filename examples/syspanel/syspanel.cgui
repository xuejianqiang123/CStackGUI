{
  "cgui": 1,
  "app": {
    "title": "系统与配置面板",
    "width": 780,
    "height": 612,
    "bg": "#F3EDF7",
    "info": {
      "product": "CStackGUI 系统与配置面板",
      "desc": "系统信息与配置面板示例：只读系统信息 + INI 配置读写",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 588, "w": 780, "h": 24 },
      "items": ["就绪", "系统信息", "刷新：—"]
    },
    {
      "id": "tab_main",
      "type": "tabs",
      "rect": { "x": 12, "y": 12, "w": 756, "h": 470 },
      "items": ["系统信息", "配置"],
      "events": { "select": "on_tab_main_select" },
      "children": [
        {
          "id": "lab_sys",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 36, "w": 300, "h": 24 },
          "text": "系统",
          "style": { "bold": true }
        },
        {
          "id": "lab_is64_k",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 62, "w": 150, "h": 24 },
          "text": "是否 64 位系统"
        },
        {
          "id": "lab_is64_v",
          "type": "label",
          "page": 0,
          "rect": { "x": 162, "y": 62, "w": 560, "h": 24 },
          "text": "（待刷新）"
        },
        {
          "id": "lab_ver_k",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 88, "w": 150, "h": 24 },
          "text": "系统版本"
        },
        {
          "id": "lab_ver_v",
          "type": "label",
          "page": 0,
          "rect": { "x": 162, "y": 88, "w": 560, "h": 24 },
          "text": "（待刷新）"
        },
        {
          "id": "lab_disk_t",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 120, "w": 300, "h": 24 },
          "text": "磁盘（用户数据目录）",
          "style": { "bold": true }
        },
        {
          "id": "lab_disk_k",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 146, "w": 150, "h": 24 },
          "text": "目录"
        },
        {
          "id": "lab_disk_v",
          "type": "label",
          "page": 0,
          "rect": { "x": 162, "y": 146, "w": 560, "h": 24 },
          "text": "（待刷新）"
        },
        {
          "id": "lab_pct_k",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 172, "w": 150, "h": 24 },
          "text": "占用率"
        },
        {
          "id": "prg_disk",
          "type": "progress",
          "page": 0,
          "rect": { "x": 162, "y": 172, "w": 300, "h": 20 },
          "mx": 100,
          "value": 0,
          "hint": "设值接口写的是「已用百分比」"
        },
        {
          "id": "lab_disk_num",
          "type": "label",
          "page": 0,
          "rect": { "x": 474, "y": 172, "w": 248, "h": 24 },
          "text": "（待刷新）"
        },
        {
          "id": "lab_env_t",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 200, "w": 300, "h": 24 },
          "text": "环境变量",
          "style": { "bold": true }
        },
        {
          "id": "lst_env",
          "type": "listbox",
          "page": 0,
          "rect": { "x": 8, "y": 226, "w": 340, "h": 162 },
          "hint": "路径只显示前 60 字符；临时目录原样；CPU 个数按整数读"
        },
        {
          "id": "lab_proc_t",
          "type": "label",
          "page": 0,
          "rect": { "x": 364, "y": 200, "w": 300, "h": 24 },
          "text": "进程存在性",
          "style": { "bold": true }
        },
        {
          "id": "lab_proc_k",
          "type": "label",
          "page": 0,
          "rect": { "x": 364, "y": 228, "w": 120, "h": 24 },
          "text": "进程名"
        },
        {
          "id": "edt_proc",
          "type": "edit",
          "page": 0,
          "rect": { "x": 488, "y": 224, "w": 160, "h": 28 },
          "text": "explorer.exe",
          "hint": "大小写不敏感；回车 = 点「检查」",
          "events": { "submit": "on_edt_proc_submit" }
        },
        {
          "id": "btn_proc",
          "type": "button",
          "page": 0,
          "rect": { "x": 652, "y": 224, "w": 96, "h": 28 },
          "text": "检查",
          "events": { "click": "on_btn_proc_click" }
        },
        {
          "id": "led_proc",
          "type": "led",
          "page": 0,
          "rect": { "x": 364, "y": 260, "w": 24, "h": 24 },
          "value": 0,
          "text": ""
        },
        {
          "id": "lab_proc_res",
          "type": "label",
          "page": 0,
          "rect": { "x": 396, "y": 260, "w": 352, "h": 24 },
          "text": "（待刷新）"
        },
        {
          "id": "lab_port_t",
          "type": "label",
          "page": 0,
          "rect": { "x": 364, "y": 294, "w": 384, "h": 24 },
          "text": "串口列表",
          "style": { "bold": true }
        },
        {
          "id": "lst_port",
          "type": "listbox",
          "page": 0,
          "rect": { "x": 364, "y": 320, "w": 384, "h": 68 },
          "hint": "一行一个端口；没有端口返回 0（不是错误）"
        },
        {
          "id": "btn_refresh",
          "type": "button",
          "page": 0,
          "rect": { "x": 8, "y": 396, "w": 180, "h": 32 },
          "text": "刷新",
          "hint": "重算 系统 / 磁盘 / 环境 / 进程 / 串口，并把当前时间写进状态栏",
          "events": { "click": "on_btn_refresh_click" }
        },
        {
          "id": "lab_hint",
          "type": "label",
          "page": 0,
          "rect": { "x": 196, "y": 396, "w": 552, "h": 32 },
          "text": "本页全部只读，不接硬件；串口只枚举，不打开"
        },
        {
          "id": "lab_cfgpath_k",
          "type": "label",
          "page": 1,
          "rect": { "x": 8, "y": 36, "w": 120, "h": 24 },
          "text": "配置文件"
        },
        {
          "id": "lab_cfgpath_v",
          "type": "label",
          "page": 1,
          "rect": { "x": 132, "y": 36, "w": 604, "h": 24 },
          "text": "（启动时确定）"
        },
        {
          "id": "tbl_cfg",
          "type": "table",
          "page": 1,
          "rect": { "x": 8, "y": 64, "w": 736, "h": 220 },
          "columns": [
            { "title": "节", "w": 160 },
            { "title": "键", "w": 200 },
            { "title": "值" }
          ],
          "hint": "每行一个配置项：节 / 键 / 值"
        },
        {
          "id": "lab_sec_k",
          "type": "label",
          "page": 1,
          "rect": { "x": 8, "y": 296, "w": 32, "h": 24 },
          "text": "节"
        },
        {
          "id": "edt_sec",
          "type": "edit",
          "page": 1,
          "rect": { "x": 44, "y": 292, "w": 180, "h": 28 },
          "text": "面板"
        },
        {
          "id": "lab_key_k",
          "type": "label",
          "page": 1,
          "rect": { "x": 232, "y": 296, "w": 32, "h": 24 },
          "text": "键"
        },
        {
          "id": "edt_key",
          "type": "edit",
          "page": 1,
          "rect": { "x": 268, "y": 292, "w": 160, "h": 28 },
          "text": "进程名"
        },
        {
          "id": "lab_val_k",
          "type": "label",
          "page": 1,
          "rect": { "x": 436, "y": 296, "w": 32, "h": 24 },
          "text": "值"
        },
        {
          "id": "edt_val",
          "type": "edit",
          "page": 1,
          "rect": { "x": 472, "y": 292, "w": 272, "h": 28 },
          "text": "explorer.exe"
        },
        {
          "id": "btn_cfg_read",
          "type": "button",
          "page": 1,
          "rect": { "x": 8, "y": 332, "w": 180, "h": 32 },
          "text": "读一项",
          "hint": "读 [节] 键，值填进右边的「值」输入框",
          "events": { "click": "on_btn_cfg_read_click" }
        },
        {
          "id": "btn_cfg_write",
          "type": "button",
          "page": 1,
          "rect": { "x": 196, "y": 332, "w": 180, "h": 32 },
          "text": "写一项",
          "hint": "写 [节] 键 = 值，写成功后重载表格",
          "events": { "click": "on_btn_cfg_write_click" }
        },
        {
          "id": "btn_cfg_reload",
          "type": "button",
          "page": 1,
          "rect": { "x": 384, "y": 332, "w": 180, "h": 32 },
          "text": "全部重载",
          "hint": "把清单里的几项读回来填进表格，并逐条写日志",
          "events": { "click": "on_btn_cfg_reload_click" }
        },
        {
          "id": "btn_cfg_copy",
          "type": "button",
          "page": 1,
          "rect": { "x": 572, "y": 332, "w": 172, "h": 32 },
          "text": "复制到剪贴板",
          "hint": "把表格内容按每行一条送进剪贴板",
          "events": { "click": "on_btn_cfg_copy_click" }
        },
        {
          "id": "lab_cfg_hint",
          "type": "label",
          "page": 1,
          "rect": { "x": 8, "y": 376, "w": 736, "h": 24 },
          "text": "默认节：面板 / 串口；首启会把默认值写进用户数据目录下的 syspanel.ini"
        }
      ]
    },
    {
      "id": "lst_log",
      "type": "listbox",
      "rect": { "x": 12, "y": 492, "w": 756, "h": 88 },
      "hint": "逐行记录操作；长到 400 条会自动清一次，免得无限增长"
    }
  ]
}
