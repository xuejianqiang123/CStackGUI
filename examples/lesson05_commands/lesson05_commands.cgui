{
  "cgui": 1,
  "app": {
    "title": "入门 05 · 命令与图形",
    "width": 760,
    "height": 610,
    "bg": "#F3EDF7",
    "events": {
      "ready": "on_app_ready"
    }
  },
  "widgets": [
    {
      "id": "menu_main",
      "type": "menu",
      "rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "nodes": [
        {
          "text": "文件",
          "children": [
            { "text": "新建画板", "id": "m_new" },
            { "text": "载入示例页", "id": "m_page" }
          ]
        },
        {
          "text": "视图",
          "children": [
            { "text": "画圆", "id": "m_circle" },
            { "text": "画方", "id": "m_rect" },
            { "text": "-" },
            { "text": "清空", "id": "m_clear" }
          ]
        }
      ],
      "events": { "click": "on_menu_click" }
    },
    {
      "id": "tb_cmd",
      "type": "toolbar",
      "rect": { "x": 16, "y": 14, "w": 728, "h": 34 },
      "items": ["新建", "画圆", "画方", "清空"],
      "hint": "工具栏：点中第几项用 cg_widget_value() 读（0 起）",
      "events": { "click": "on_tb_cmd_click" }
    },

    {
      "id": "lab_k_menubutton",
      "type": "label",
      "rect": { "x": 16, "y": 62, "w": 104, "h": 22 },
      "text": "menubutton 菜单",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "mbtn_more",
      "type": "menubutton",
      "rect": { "x": 120, "y": 56, "w": 150, "h": 32 },
      "text": "更多命令",
      "hint": "长得像按钮，点开是菜单；选中的项同样用 cg_menu_last_id() 认",
      "nodes": [
        { "text": "载入示例页", "id": "m_page" },
        { "text": "复制画板尺寸", "id": "m_size" }
      ],
      "events": { "click": "on_mbtn_more_click" }
    },
    {
      "id": "lab_k_colorpicker",
      "type": "label",
      "rect": { "x": 16, "y": 106, "w": 104, "h": 22 },
      "text": "colorpicker 取色",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "cp_ink",
      "type": "colorpicker",
      "rect": { "x": 120, "y": 102, "w": 64, "h": 28 },
      "value": 6774948,
      "hint": "当前颜色存在 value（0xRRGGBB）；点它弹系统取色器，改完派发 change",
      "events": { "change": "on_cp_ink_change" }
    },
    {
      "id": "lab_k_button",
      "type": "label",
      "rect": { "x": 16, "y": 150, "w": 104, "h": 22 },
      "text": "button 按钮",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "btn_draw_circle",
      "type": "button",
      "rect": { "x": 120, "y": 144, "w": 96, "h": 32 },
      "text": "画圆",
      "hint": "和菜单「视图 / 画圆」是同一件事：两边都调 do_command(CMD_CIRCLE)",
      "events": { "click": "on_btn_draw_circle_click" }
    },
    {
      "id": "btn_draw_rect",
      "type": "button",
      "rect": { "x": 224, "y": 144, "w": 96, "h": 32 },
      "text": "画方",
      "events": { "click": "on_btn_draw_rect_click" }
    },
    {
      "id": "btn_draw_clear",
      "type": "button",
      "rect": { "x": 328, "y": 144, "w": 96, "h": 32 },
      "text": "清空",
      "events": { "click": "on_btn_draw_clear_click" }
    },
    {
      "id": "btn_undo",
      "type": "button",
      "rect": { "x": 432, "y": 144, "w": 96, "h": 32 },
      "text": "撤销",
      "hint": "这一课没做撤销，所以它一直是灰的 —— 禁用的控件要在文案或提示里说清为什么不能用",
      "enabled": false
    },
    {
      "id": "lab_k_canvas",
      "type": "label",
      "rect": { "x": 16, "y": 194, "w": 104, "h": 22 },
      "text": "canvas 画板",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "cv_board",
      "type": "canvas",
      "rect": { "x": 120, "y": 190, "w": 400, "h": 300 },
      "style": { "bg": "#FFFFFF" },
      "hint": "在画板里点一下 = 在点到的位置画一个小圆；图形用 cg_canvas_* 画，重绘时按序回放",
      "events": { "click": "on_cv_board_click" }
    },

    {
      "id": "lab_k_shape",
      "type": "label",
      "rect": { "x": 544, "y": 62, "w": 200, "h": 22 },
      "text": "shape 外形框",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "sh_rect",
      "type": "shape",
      "rect": { "x": 544, "y": 88, "w": 60, "h": 60 },
      "format": "rect",
      "style": { "bg": "#D0BCFF" }
    },
    {
      "id": "sh_round",
      "type": "shape",
      "rect": { "x": 614, "y": 88, "w": 60, "h": 60 },
      "format": "roundrect",
      "style": { "bg": "#FFD8E4" }
    },
    {
      "id": "sh_circle",
      "type": "shape",
      "rect": { "x": 684, "y": 88, "w": 60, "h": 60 },
      "format": "ellipse",
      "style": { "bg": "#BCE0FD" }
    },
    {
      "id": "lab_k_image",
      "type": "label",
      "rect": { "x": 544, "y": 164, "w": 200, "h": 22 },
      "text": "image 图片",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "img_logo",
      "type": "image",
      "rect": { "x": 544, "y": 190, "w": 120, "h": 120 },
      "src": "assets/icon.png",
      "hint": "按原比例放进矩形；换图用 cg_widget_set_image()"
    },
    {
      "id": "lab_k_browser",
      "type": "label",
      "rect": { "x": 544, "y": 326, "w": 200, "h": 22 },
      "text": "browser 网页（实验性）",
      "style": { "size": 9, "fg": "#49454F" }
    },
    {
      "id": "br_page",
      "type": "browser",
      "rect": { "x": 544, "y": 352, "w": 200, "h": 160 },
      "src": "about:blank",
      "hint": "靠系统 WebBrowser 控件（IE 内核）；用 cg_browser_navigate(w, \"网址或本地 html\") 换页。空白就是还没载入"
    },
    {
      "id": "btn_br_load",
      "type": "button",
      "rect": { "x": 544, "y": 520, "w": 200, "h": 32 },
      "text": "载入示例页",
      "hint": "程序自己写一个 html 到用户数据目录，再让 browser 打开它",
      "events": { "click": "on_btn_br_load_click" }
    },

    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 586, "w": 760, "h": 24 },
      "items": ["准备就绪"]
    }
  ]
}
