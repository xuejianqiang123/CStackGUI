{
  "cgui": 1,
  "app": {
    "title": "入门 04 · 数据与日志",
    "width": 760,
    "height": 560,
    "bg": "#F3EDF7"
  },
  "widgets": [
    {
      "id": "tmr_beat",
      "type": "timer",
      "period": 1000,
      "events": { "tick": "on_tmr_beat_tick" }
    },
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 536, "w": 760, "h": 24 },
      "items": ["列表 3 · 树 8 · 表格 3", "选中：-", "心跳 0"]
    },
    {
      "id": "btn_log_clear",
      "type": "button",
      "rect": { "x": 16, "y": 16, "w": 236, "h": 32 },
      "text": "清空日志",
      "hint": "cg_term_clear(日志)",
      "events": { "click": "on_btn_log_clear_click" }
    },
    {
      "id": "btn_log_save",
      "type": "button",
      "rect": { "x": 260, "y": 16, "w": 236, "h": 32 },
      "text": "保存日志",
      "hint": "cg_term_save(日志, 路径)：存成 UTF-8 + CRLF 的文本文件",
      "events": { "click": "on_btn_log_save_click" }
    },
    {
      "id": "btn_export",
      "type": "button",
      "rect": { "x": 504, "y": 16, "w": 240, "h": 32 },
      "text": "导出（未实现）",
      "enabled": false,
      "hint": "禁用态示范：enabled=false 的按钮由皮肤画成灰底灰字（0xECECEE / 0x9A9A9E），点不动、回调一次也不来",
      "events": { "click": "on_btn_export_click" }
    },
    {
      "id": "tab_data",
      "type": "tabs",
      "rect": { "x": 16, "y": 60, "w": 366, "h": 460 },
      "items": ["列表框", "树", "表格", "图表"],
      "events": { "select": "on_tab_data_select" },
      "children": [
        {
          "id": "lab_list",
          "type": "label",
          "page": 0,
          "rect": { "x": 8, "y": 36, "w": 200, "h": 24 },
          "text": "listbox 列表框",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        },
        {
          "id": "lst_items",
          "type": "listbox",
          "page": 0,
          "rect": { "x": 8, "y": 64, "w": 348, "h": 320 },
          "items": ["苹果", "香蕉", "橘子"],
          "value": -1,
          "hint": "cg_widget_list_add / clear / count / item；选中项 = cg_widget_value",
          "events": { "select": "on_lst_items_select" }
        },
        {
          "id": "btn_list_add",
          "type": "button",
          "page": 0,
          "rect": { "x": 8, "y": 392, "w": 170, "h": 32 },
          "text": "加一条",
          "hint": "cg_widget_list_addf(列表, \"条目 %d\", n)",
          "events": { "click": "on_btn_list_add_click" }
        },
        {
          "id": "btn_list_clear",
          "type": "button",
          "page": 0,
          "rect": { "x": 186, "y": 392, "w": 170, "h": 32 },
          "text": "清空",
          "hint": "cg_widget_list_clear(列表)",
          "events": { "click": "on_btn_list_clear_click" }
        },
        {
          "id": "lab_tree",
          "type": "label",
          "page": 1,
          "rect": { "x": 8, "y": 36, "w": 200, "h": 24 },
          "text": "tree 树",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        },
        {
          "id": "tre_dir",
          "type": "tree",
          "page": 1,
          "rect": { "x": 8, "y": 64, "w": 348, "h": 320 },
          "nodes": [
            {
              "text": "项目",
              "expanded": true,
              "children": [
                {
                  "text": "runtime",
                  "children": [{ "text": "core" }, { "text": "skin" }]
                },
                { "text": "examples" },
                { "text": "docs" }
              ]
            },
            {
              "text": "构建产物",
              "children": [{ "text": "build" }]
            }
          ],
          "hint": "cg_tree_add(树, parent, 文字)；parent 传 -1 = 加在根上",
          "events": {
            "select": "on_tre_dir_select",
            "expand": "on_tre_dir_expand",
            "collapse": "on_tre_dir_collapse"
          }
        },
        {
          "id": "btn_tree_add",
          "type": "button",
          "page": 1,
          "rect": { "x": 8, "y": 392, "w": 170, "h": 32 },
          "text": "加节点",
          "hint": "parent = cg_tree_selected(树)：加在选中节点下面，没选中就加到根上",
          "events": { "click": "on_btn_tree_add_click" }
        },
        {
          "id": "btn_tree_all",
          "type": "button",
          "page": 1,
          "rect": { "x": 186, "y": 392, "w": 170, "h": 32 },
          "text": "全展开",
          "hint": "cg_tree_expand(树, 下标, 1)",
          "events": { "click": "on_btn_tree_all_click" }
        },
        {
          "id": "lab_table",
          "type": "label",
          "page": 2,
          "rect": { "x": 8, "y": 36, "w": 200, "h": 24 },
          "text": "table 表格",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        },
        {
          "id": "tbl_data",
          "type": "table",
          "page": 2,
          "rect": { "x": 8, "y": 64, "w": 348, "h": 320 },
          "columns": [
            { "title": "姓名", "w": 106 },
            { "title": "城市", "w": 106 },
            { "title": "状态" }
          ],
          "rows": [
            ["张三", "上海", "在职"],
            ["李四", "成都", "试用"],
            ["王五", "杭州", "在职"]
          ],
          "multi": true,
          "check": true,
          "hint": "cg_table_add_row / clear / row_count / cell(行,列)；勾选列 = cg_table_checked",
          "events": {
            "select": "on_tbl_data_select",
            "check": "on_tbl_data_check"
          }
        },
        {
          "id": "btn_row_add",
          "type": "button",
          "page": 2,
          "rect": { "x": 8, "y": 392, "w": 170, "h": 32 },
          "text": "加一行",
          "hint": "cg_table_add_row(表格, cells, 列数)",
          "events": { "click": "on_btn_row_add_click" }
        },
        {
          "id": "btn_row_clear",
          "type": "button",
          "page": 2,
          "rect": { "x": 186, "y": 392, "w": 170, "h": 32 },
          "text": "清空",
          "hint": "cg_table_clear(表格)",
          "events": { "click": "on_btn_row_clear_click" }
        },
        {
          "id": "lab_chart",
          "type": "label",
          "page": 3,
          "rect": { "x": 8, "y": 36, "w": 200, "h": 24 },
          "text": "chart 图表",
          "style": { "font": "Microsoft YaHei UI", "size": 9 }
        },
        {
          "id": "cht_line",
          "type": "chart",
          "page": 3,
          "rect": { "x": 8, "y": 64, "w": 348, "h": 180 },
          "items": ["负载"],
          "value": 40,
          "min": 0,
          "max": 100,
          "format": "line",
          "hint": "cg_chart_push(图, 0, 值)：折线；系列名 = items，窗口点数 = value（不是当前值）"
        },
        {
          "id": "cht_bar",
          "type": "chart",
          "page": 3,
          "rect": { "x": 8, "y": 252, "w": 348, "h": 180 },
          "items": ["错误"],
          "value": 30,
          "min": 0,
          "max": 20,
          "format": "bar",
          "hint": "同一个回调里给两张图各推一个点（format 换成 \"bar\" 就是柱状）"
        }
      ]
    },
    {
      "id": "sp_main",
      "type": "splitter",
      "rect": { "x": 390, "y": 60, "w": 6, "h": 460 },
      "hint": "左右拖动：撑开左边数据区，日志区整体让位并吃掉余量（中间不要夹控件）",
      "events": { "release": "on_sp_main_release" }
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 404, "y": 60, "w": 340, "h": 460 },
      "checked": true,
      "value": 500,
      "hint": "日志区：每秒一行心跳（RX 绿）/ 你的每个操作（TX 蓝）/ 程序说明（-- 灰）"
    }
  ]
}
