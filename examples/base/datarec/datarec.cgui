{
  "cgui": 1,
  "app": {
    "title": "采集记录器",
    "width": 900,
    "height": 620,
    "bg": "#F3EDF7",
    "events": { "close": "on_win_close" },
    "info": {
      "product": "CStackGUI 采集记录器",
      "desc": "模拟采集 + 实时曲线 + CSV 落盘 + 回放",
      "version": "1.0.0.0",
      "author": "CStackGUI"
    }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 596, "w": 900, "h": 24 },
      "items": ["待机", "已采集 0 点 · 时长 0.0 s", "CSV: （未保存）"]
    },
    {
      "id": "cht_wave",
      "type": "chart",
      "rect": { "x": 12, "y": 12, "w": 560, "h": 420 },
      "items": ["设备A", "设备B"],
      "value": 200,
      "vmin": 0,
      "vmax": 100,
      "hint": "两条曲线：一次推一个点的接口，value = 窗口保留的点数（不是当前值）"
    },
    {
      "id": "edt_path",
      "type": "edit",
      "rect": { "x": 12, "y": 440, "w": 560, "h": 30 },
      "text": "（尚未保存）",
      "input": 1,
      "hint": "最近一次保存 / 回放的 CSV 路径（只读）"
    },
    {
      "id": "btn_start",
      "type": "button",
      "rect": { "x": 12, "y": 482, "w": 134, "h": 36 },
      "text": "开始采集",
      "hint": "挂一颗 200ms 的一次性定时器；回调里自己重挂，形成周期",
      "events": { "click": "on_btn_start_click" }
    },
    {
      "id": "btn_stop",
      "type": "button",
      "rect": { "x": 154, "y": 482, "w": 134, "h": 36 },
      "text": "停止",
      "hint": "杀掉在跳的定时器；内存缓冲留着，保存 CSV 要用",
      "events": { "click": "on_btn_stop_click" }
    },
    {
      "id": "btn_save",
      "type": "button",
      "rect": { "x": 296, "y": 482, "w": 134, "h": 36 },
      "text": "保存 CSV",
      "hint": "先覆盖写表头，再按 4KB 分块追加，不在内存里拼整份 CSV",
      "events": { "click": "on_btn_save_click" }
    },
    {
      "id": "btn_replay",
      "type": "button",
      "rect": { "x": 438, "y": 482, "w": 134, "h": 36 },
      "text": "回放",
      "hint": "读回 CSV → 逐行解析 → 清空图表后重放",
      "events": { "click": "on_btn_replay_click" }
    },
    {
      "id": "lst_log",
      "type": "listbox",
      "rect": { "x": 584, "y": 12, "w": 304, "h": 568 },
      "hint": "采集与落盘日志：追加一条 + 滚到底"
    }
  ]
}
