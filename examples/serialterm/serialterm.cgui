{
  "cgui": 1,
  "app": {
    "title": "串口助手（cg_serial 示例）",
    "width": 1000,
    "height": 760,
    "bg": "#F3EDF7",
    "events": {
      "close": "on_close",
      "destroy": "on_destroy"
    },
    "info": {
      "product": "CStackGUI 串口助手示例",
      "desc": "通信类工具样板：串口组件（无界面控件）发 arrive；数据落到 terminal（带十六进制 / 时间戳 / 按帧切分）与曲线",
      "version": "2.0.0.0",
      "author": "CStackGUI"
    }
  },
  "styles": {
    "label": { "font": "Microsoft YaHei UI", "size": 9, "fg": "#1D1B20" },
    "input": { "font": "Microsoft YaHei UI", "size": 10 }
  },
  "widgets": [
    {
      "id": "sb_main",
      "type": "statusbar",
      "rect": { "x": 0, "y": 734, "w": 1000, "h": 26 },
      "items": ["未连接", "RX 0 B", "TX 0 B", "0 帧 / 丢 0 B"]
    },
    {
      "id": "lab_port",
      "type": "label",
      "rect": { "x": 12, "y": 14, "w": 36, "h": 24 },
      "text": "端口",
      "style": "label"
    },
    {
      "id": "cmb_port",
      "type": "combo",
      "rect": { "x": 52, "y": 12, "w": 150, "h": 200 },
      "items": ["（启动时枚举）"],
      "hint": "本机串口名（COM3 这种）；插拔设备后点「刷新」重新枚举"
    },
    {
      "id": "lab_baud",
      "type": "label",
      "rect": { "x": 210, "y": 14, "w": 52, "h": 24 },
      "text": "波特率",
      "style": "label"
    },
    {
      "id": "cmb_baud",
      "type": "combo",
      "rect": { "x": 266, "y": 12, "w": 96, "h": 200 },
      "items": ["1200", "2400", "4800", "9600", "19200", "38400", "57600", "115200", "230400", "460800", "921600"],
      "value": 7,
      "hint": "链路的波特率（点「打开串口」时写进串口组件）"
    },
    {
      "id": "btn_connect",
      "type": "button",
      "rect": { "x": 372, "y": 10, "w": 96, "h": 32 },
      "text": "打开串口",
      "hint": "打开 / 关闭当前选中的串口",
      "events": { "click": "on_connect_click" }
    },
    {
      "id": "btn_refresh",
      "type": "button",
      "rect": { "x": 474, "y": 10, "w": 64, "h": 32 },
      "text": "刷新",
      "hint": "重新枚举本机串口，填进左边的下拉框",
      "events": { "click": "on_refresh_click" }
    },
    {
      "id": "btn_clear",
      "type": "button",
      "rect": { "x": 544, "y": 10, "w": 64, "h": 32 },
      "text": "清空",
      "hint": "丢掉还没取走的接收数据，并清空日志视图（XCOM 的「清除接收」）",
      "events": { "click": "on_clear_click" }
    },
    {
      "id": "btn_savelog",
      "type": "button",
      "rect": { "x": 614, "y": 10, "w": 88, "h": 32 },
      "text": "保存日志",
      "hint": "把日志视图存成 UTF-8 文本文件（XCOM 的「保存窗口」）",
      "events": { "click": "on_save_log_click" }
    },
    {
      "id": "led_link",
      "type": "led",
      "rect": { "x": 712, "y": 17, "w": 140, "h": 18 },
      "text": "未连接",
      "value": 0,
      "style": { "fg": "#1B6E33" }
    },
    {
      "id": "lab_bits",
      "type": "label",
      "rect": { "x": 12, "y": 52, "w": 48, "h": 24 },
      "text": "数据位",
      "style": "label"
    },
    {
      "id": "cmb_bits",
      "type": "combo",
      "rect": { "x": 66, "y": 50, "w": 70, "h": 200 },
      "items": ["8", "7", "6", "5"],
      "value": 0,
      "hint": "8 位为主；老设备偶见 7 位（配偶校验就是 7E1）"
    },
    {
      "id": "lab_stop",
      "type": "label",
      "rect": { "x": 144, "y": 52, "w": 48, "h": 24 },
      "text": "停止位",
      "style": "label"
    },
    {
      "id": "cmb_stop",
      "type": "combo",
      "rect": { "x": 198, "y": 50, "w": 60, "h": 200 },
      "items": ["1", "2"],
      "value": 0,
      "hint": "1 位为主；2 位常见于一些仪表"
    },
    {
      "id": "lab_parity",
      "type": "label",
      "rect": { "x": 266, "y": 52, "w": 36, "h": 24 },
      "text": "校验",
      "style": "label"
    },
    {
      "id": "cmb_parity",
      "type": "combo",
      "rect": { "x": 306, "y": 50, "w": 76, "h": 200 },
      "items": ["无", "奇", "偶"],
      "value": 0,
      "hint": "0 无 / 1 奇 / 2 偶 —— 下标就是 cg_widget_serial_set_format 要的值"
    },
    {
      "id": "lab_fmt",
      "type": "label",
      "rect": { "x": 396, "y": 52, "w": 580, "h": 24 },
      "text": "帧格式是「数据位 + 校验 + 停止位」，比如 8N1 / 7E1 —— 板子怎么配就选成一样（框架支持全参数）",
      "style": "label"
    },
    {
      "id": "chk_hexview",
      "type": "checkbox",
      "rect": { "x": 12, "y": 88, "w": 112, "h": 26 },
      "text": "16 进制显示",
      "hint": "日志里的收发都按十六进制显示（XCOM 的「16进制显示」）",
      "events": { "change": "on_hexview_change" }
    },
    {
      "id": "chk_stamp",
      "type": "checkbox",
      "rect": { "x": 130, "y": 88, "w": 96, "h": 26 },
      "text": "时间戳",
      "checked": true,
      "hint": "每行前面加 [时:分:秒]（XCOM 的「时间戳」）",
      "events": { "change": "on_stamp_change" }
    },
    {
      "id": "chk_frame",
      "type": "checkbox",
      "rect": { "x": 232, "y": 88, "w": 112, "h": 26 },
      "text": "按帧显示",
      "hint": "把字节流按「帧间静默」切成整帧，每帧单独一行并报长度与 CRC —— 这一条 XCOM 没有",
      "events": { "change": "on_frame_change" }
    },
    {
      "id": "spn_gap",
      "type": "edit",
      "rect": { "x": 350, "y": 88, "w": 64, "h": 26 },
      "spin": true,
      "min": 1,
      "max": 2000,
      "value": 20,
      "hint": "按帧显示的静默间隔（毫秒）：隔这么久没新字节就算一帧结束。Modbus/RTU 按波特率算 t3.5（115200 取 1、9600 取 4）",
      "style": "input"
    },
    {
      "id": "lab_gap",
      "type": "label",
      "rect": { "x": 418, "y": 92, "w": 56, "h": 20 },
      "text": "静默ms",
      "style": "label"
    },
    {
      "id": "chk_autosave",
      "type": "checkbox",
      "rect": { "x": 484, "y": 88, "w": 112, "h": 26 },
      "text": "自动保存",
      "hint": "收到的字节按十六进制文本追加落盘（XCOM 的「自动保存」）",
      "events": { "change": "on_autosave_change" }
    },
    {
      "id": "lab_savehint",
      "type": "label",
      "rect": { "x": 602, "y": 92, "w": 386, "h": 20 },
      "text": "（自动保存落到数据目录的 rx_log.txt：十六进制文本，字节精确、可 grep）",
      "style": "label"
    },
    {
      "id": "term_log",
      "type": "terminal",
      "rect": { "x": 8, "y": 122, "w": 984, "h": 372 },
      "grow": 1,
      "checked": true,
      "value": 800,
      "items": [
        "串口助手就绪。选好端口 / 波特率 / 帧格式，点「打开串口」。",
        "收到的数据落到这里（terminal 控件）：RX 绿 / TX 蓝 / -- 灰。",
        "显示开关：16 进制、时间戳、按帧显示（带 CRC）、自动保存。"
      ],
      "hint": "日志视图：格式（hex / 文本）、时间戳、方向着色、行数上限与存盘全由控件管"
    },
    {
      "id": "ser_main",
      "type": "serial",
      "port": "COM1",
      "baud": 115200,
      "bits": 8,
      "stop": 1,
      "parity": 0,
      "hint": "串口组件（无界面）：画布上是图标，运行时不建窗口；数据到达发 arrive。帧格式三个字段画布属性面板也能改，运行期改走 cg_widget_serial_set_format",
      "events": { "arrive": "on_arrive" }
    },
    {
      "id": "sp_main",
      "type": "splitter",
      "rect": { "x": 8, "y": 498, "w": 984, "h": 6 },
      "format": "row",
      "hint": "上下拖动：日志区变高、下面让位",
      "events": { "release": "on_split_release" }
    },
    {
      "id": "grp_send",
      "type": "group",
      "rect": { "x": 8, "y": 506, "w": 984, "h": 146 },
      "text": "发送",
      "style": { "use": "label", "bg": "#F7F2FA" },
      "children": [
        {
          "id": "edt_send",
          "type": "edit",
          "rect": { "x": 12, "y": 28, "w": 520, "h": 28 },
          "text": "",
          "style": "input",
          "hint": "要发送的内容；勾了 HEX 就写 1A 2B 3C 这种",
          "events": { "submit": "on_send_submit" }
        },
        {
          "id": "chk_hex",
          "type": "checkbox",
          "rect": { "x": 540, "y": 29, "w": 86, "h": 26 },
          "text": "HEX 发送",
          "hint": "把输入按十六进制解析成字节再发（空格可有可无）",
          "events": { "change": "on_hex_change" }
        },
        {
          "id": "chk_newline",
          "type": "checkbox",
          "rect": { "x": 628, "y": 29, "w": 86, "h": 26 },
          "text": "发送新行",
          "hint": "发完追加 \\r\\n（AT 指令和多数文本协议要它）",
          "events": { "change": "on_newline_change" }
        },
        {
          "id": "btn_send",
          "type": "button",
          "rect": { "x": 716, "y": 26, "w": 90, "h": 32 },
          "text": "发送",
          "hint": "发送（在输入框里直接回车也一样）",
          "events": { "click": "on_send_click" }
        },
        {
          "id": "chk_timed",
          "type": "checkbox",
          "rect": { "x": 812, "y": 29, "w": 84, "h": 26 },
          "text": "定时发送",
          "hint": "按周期反复发上面那一行（XCOM 的「定时发送」）",
          "events": { "change": "on_timed_change" }
        },
        {
          "id": "spn_cycle",
          "type": "edit",
          "rect": { "x": 900, "y": 28, "w": 64, "h": 26 },
          "spin": true,
          "min": 50,
          "max": 60000,
          "value": 1000,
          "hint": "定时发送 / 多条发送的周期（毫秒）",
          "style": "input"
        },
        {
          "id": "edt_multi",
          "type": "edit",
          "rect": { "x": 12, "y": 64, "w": 584, "h": 68 },
          "multiline": true,
          "scroll": 2,
          "maxlen": 65535,
          "style": "input",
          "text": "一行一条；# 开头是注释，空行跳过。\n依次发送：每条按下面的间隔发一条。\n# 例：AT\n# 例：01 03 00 00 00 0A C5 CD",
          "hint": "多条发送（XCOM 的「多条发送」标签页）：一行一条命令，可循环"
        },
        {
          "id": "btn_sendall",
          "type": "button",
          "rect": { "x": 604, "y": 62, "w": 92, "h": 28 },
          "text": "依次发送",
          "hint": "把左边每一行按顺序发一遍（勾了「循环」就一直轮）",
          "events": { "click": "on_sendall_click" }
        },
        {
          "id": "btn_stop",
          "type": "button",
          "rect": { "x": 702, "y": 62, "w": 92, "h": 28 },
          "text": "停止发送",
          "hint": "停掉定时发送 / 多条轮发（XCOM 的「停止发送」）",
          "events": { "click": "on_stop_click" }
        },
        {
          "id": "btn_openfile",
          "type": "button",
          "rect": { "x": 800, "y": 62, "w": 86, "h": 28 },
          "text": "打开文件",
          "hint": "把一个文本文件读进「多条发送」框（一行一条）",
          "events": { "click": "on_openfile_click" }
        },
        {
          "id": "btn_sendfile",
          "type": "button",
          "rect": { "x": 892, "y": 62, "w": 80, "h": 28 },
          "text": "发送文件",
          "hint": "把一个文本文件的内容原样发出去（XCOM 的「发送文件」）",
          "events": { "click": "on_sendfile_click" }
        },
        {
          "id": "chk_loop",
          "type": "checkbox",
          "rect": { "x": 604, "y": 96, "w": 92, "h": 26 },
          "text": "循环",
          "hint": "「依次发送」发到最后一条后回到第一条（轮询命令序列）",
          "events": { "change": "on_loop_change" }
        },
        {
          "id": "spn_multi",
          "type": "edit",
          "rect": { "x": 702, "y": 96, "w": 64, "h": 26 },
          "spin": true,
          "min": 50,
          "max": 60000,
          "value": 500,
          "hint": "多条发送时每条之间的间隔（毫秒）",
          "style": "input"
        },
        {
          "id": "lab_multi",
          "type": "label",
          "rect": { "x": 770, "y": 100, "w": 200, "h": 20 },
          "text": "多条之间的间隔(ms)",
          "style": "label"
        }
      ]
    },
    {
      "id": "cht_rate",
      "type": "chart",
      "rect": { "x": 8, "y": 660, "w": 984, "h": 66 },
      "items": ["B/s"],
      "value": 60,
      "min": 0,
      "max": 256,
      "format": "line",
      "hint": "每秒收到的字节数（同一份数据既进日志也进曲线：落点由 on_arrive 决定）"
    }
  ]
}
